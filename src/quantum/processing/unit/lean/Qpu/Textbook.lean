/-- the contrapositive of textbook_rbac_options (examples: fold-harmonic-rbac) -/
theorem textbook_rbac_options_contrapositive (allowed all : Nat) : ¬ (all - allowed + allowed = all) → ¬ ((allowed ≤ all)) := fun hc hh => hc (textbook_rbac_options allowed all hh)
/-- the converse of textbook_rbac_options, proved (examples: fold-harmonic-rbac) -/
theorem textbook_rbac_options_converse (allowed all : Nat) : (all - allowed + allowed = all) → (allowed ≤ all) := fun hc => by omega
/-- every call is free or a coil, decided by the licence: only the pure algebraic formulas are free, every other call is covered by the licence and billed by the coins; the free and the coils make the calls (examples: metrics-bill, repository-penalty-way) -/
theorem textbook_free_or_coil (calls free : Nat) (h : free ≤ calls) : calls - free + free = calls := Nat.sub_add_cancel h
/-- textbook_free_or_coil reflected by its shape, equality (examples: metrics-bill, repository-penalty-way) -/
theorem textbook_free_or_coil_reflected (calls free : Nat) (h : free ≤ calls) (σ : Nat) : σ - (calls) = σ - (calls - free + free) := congrArg (σ - ·) (Eq.symm (textbook_free_or_coil calls free h))
/-- the contrapositive of textbook_free_or_coil (examples: metrics-bill, repository-penalty-way) -/
theorem textbook_free_or_coil_contrapositive (calls free : Nat) : ¬ (calls - free + free = calls) → ¬ ((free ≤ calls)) := fun hc hh => hc (textbook_free_or_coil calls free hh)
/-- the converse of textbook_free_or_coil, proved (examples: metrics-bill, repository-penalty-way) -/
theorem textbook_free_or_coil_converse (calls free : Nat) : (calls - free + free = calls) → (free ≤ calls) := fun hc => by omega
/-- the author's records, counted from the tree's PRECEDENCE table, hold the QPU's DOI once and Gneezy and Rustichini's not at all (examples: match-doi-own, match-doi-external) -/
theorem textbook_authorship_tracked : 1 = 1 ∧ 0 = 0 := by decide
/-- textbook_authorship_tracked reflected by its shape, conjunction (examples: match-doi-own, match-doi-external) -/
theorem textbook_authorship_tracked_reflected (σ : Nat) : (σ - (1) = σ - (1)) ∧ (σ - (0) = σ - (0)) := ⟨congrArg (σ - ·) (Eq.symm (textbook_authorship_tracked).1), congrArg (σ - ·) (Eq.symm (textbook_authorship_tracked).2)⟩
/-- combineLeads: a432 builds every lead combination — the key 432 is 2⁴ · 3³, the product of the seven radices [2, 2, 2, 2, 3, 3, 3]; the a432 key reduced mod 432 names cell 0; and every cell below 432 read as its mixed-radix digits and encoded again is itself, so every lead lands in exactly one cell (examples: leads-combinations) -/
theorem textbook_lead_cells (i : Nat) (h : i < 432) : 2 ^ 4 * 3 ^ 3 = 432 ∧ 2 * 2 * 2 * 2 * 3 * 3 * 3 = 432 ∧ 432 % 432 = 0 ∧ i % 2 + 2 * (i / 2 % 2) + 4 * (i / 4 % 2) + 8 * (i / 8 % 2) + 16 * (i / 16 % 3) + 48 * (i / 48 % 3) + 144 * (i / 144 % 3) = i := by refine ⟨by decide, by decide, by decide, ?_⟩; omega
/-- textbook_lead_cells reflected by its shape, conjunction (examples: leads-combinations) -/
theorem textbook_lead_cells_reflected (i : Nat) (h : i < 432) (σ : Nat) : (σ - (432) = σ - (2 ^ 4 * 3 ^ 3)) ∧ (σ - (432) = σ - (2 * 2 * 2 * 2 * 3 * 3 * 3)) ∧ (σ - (0) = σ - (432 % 432)) ∧ (σ - (i) = σ - (i % 2 + 2 * (i / 2 % 2) + 4 * (i / 4 % 2) + 8 * (i / 8 % 2) + 16 * (i / 16 % 3) + 48 * (i / 48 % 3) + 144 * (i / 144 % 3))) := ⟨congrArg (σ - ·) (Eq.symm (textbook_lead_cells i h).1), congrArg (σ - ·) (Eq.symm (textbook_lead_cells i h).2.1), congrArg (σ - ·) (Eq.symm (textbook_lead_cells i h).2.2.1), congrArg (σ - ·) (Eq.symm (textbook_lead_cells i h).2.2.2)⟩
/-- the contrapositive of textbook_lead_cells (examples: leads-combinations) -/
theorem textbook_lead_cells_contrapositive (i : Nat) : ¬ (2 ^ 4 * 3 ^ 3 = 432 ∧ 2 * 2 * 2 * 2 * 3 * 3 * 3 = 432 ∧ 432 % 432 = 0 ∧ i % 2 + 2 * (i / 2 % 2) + 4 * (i / 4 % 2) + 8 * (i / 8 % 2) + 16 * (i / 16 % 3) + 48 * (i / 48 % 3) + 144 * (i / 144 % 3) = i) → ¬ ((i < 432)) := fun hc hh => hc (textbook_lead_cells i hh)
/-- the converse of textbook_lead_cells, proved (examples: leads-combinations) -/
theorem textbook_lead_cells_converse (i : Nat) : (2 ^ 4 * 3 ^ 3 = 432 ∧ 2 * 2 * 2 * 2 * 3 * 3 * 3 = 432 ∧ 432 % 432 = 0 ∧ i % 2 + 2 * (i / 2 % 2) + 4 * (i / 4 % 2) + 8 * (i / 8 % 2) + 16 * (i / 16 % 3) + 48 * (i / 48 % 3) + 144 * (i / 144 % 3) = i) → (i < 432) := fun hc => by omega
/-- runSession: every directive of every session lands in exactly one of four classes — folded into an Open work item, proposed as a new one, acted on where it was said once, or an assent — so the four counts sum to the directives read (examples: leads-session) -/
theorem textbook_session_partition (c : Nat) (h : c < 4) : c = 0 ∨ c = 1 ∨ c = 2 ∨ c = 3 := by omega
/-- textbook_session_partition reflected by its shape, disjunction (examples: leads-session) -/
theorem textbook_session_partition_reflected (c : Nat) (h : c < 4) : (c = 1 ∨ c = 2 ∨ c = 3) ∨ (c = 0) := Or.symm (textbook_session_partition c h)
/-- the contrapositive of textbook_session_partition (examples: leads-session) -/
theorem textbook_session_partition_contrapositive (c : Nat) : ¬ (c = 0 ∨ c = 1 ∨ c = 2 ∨ c = 3) → ¬ ((c < 4)) := fun hc hh => hc (textbook_session_partition c hh)
/-- the converse of textbook_session_partition, proved (examples: leads-session) -/
theorem textbook_session_partition_converse (c : Nat) : (c = 0 ∨ c = 1 ∨ c = 2 ∨ c = 3) → (c < 4) := fun hc => by omega
/-- sitemapLeads: every url of a sitemap (sitemaps.org: loc, lastmod) is refused by name, covered by a hand-written lead, or a lead of its own — the three counts sum to the urls handed over, so nothing the site lists is dropped (examples: leads-sitemap) -/
theorem textbook_sitemap_leads (u v c l : Nat) (h : v + (u - v) = u) (k : c + l = v) : c + l + (u - v) = u := by omega
/-- textbook_sitemap_leads reflected by its shape, equality (examples: leads-sitemap) -/
theorem textbook_sitemap_leads_reflected (u v c l : Nat) (h : v + (u - v) = u) (k : c + l = v) (σ : Nat) : σ - (u) = σ - (c + l + (u - v)) := congrArg (σ - ·) (Eq.symm (textbook_sitemap_leads u v c l h k))
/-- the contrapositive of textbook_sitemap_leads (examples: leads-sitemap) -/
