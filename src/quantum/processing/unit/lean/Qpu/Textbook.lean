theorem textbook_raid_bit_zero_verify_contrapositive (v m d b : Nat) : ¬ (m + d + v = b ∧ m + d < b) → ¬ ((v + m + d = b) ∧ (1 ≤ v)) := fun hc hh => hc (textbook_raid_bit_zero_verify v m d b hh.1 hh.2)
/-- the converse of textbook_raid_bit_zero_verify, proved (examples: raid-bit-zero-verify) -/
