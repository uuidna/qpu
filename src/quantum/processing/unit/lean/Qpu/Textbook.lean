/-- the converse of textbook_ports_cover, refuted by a counterexample the kernel decides (examples: configure-adapters-port) -/
theorem textbook_ports_cover_converse_refuted : ¬ ∀ (complete blocked total : Nat), (total - blocked = complete) → (complete + blocked = total) := fun h => absurd (h 0 1 0 (by decide)) (by decide)
/-- harmonic options by default: the referrer's address, or the a432 key, reduced modulo the number of combinations a schema's enums hold is always below that number, so the default it names is always one of the combinations (examples: fold-harmonic, payload-hooks-collapse) -/
theorem textbook_harmonic_default (n k : Nat) (h : 0 < n) : k % n < n := Nat.mod_lt k h
/-- textbook_harmonic_default reflected by its shape, order (examples: fold-harmonic, payload-hooks-collapse) -/
theorem textbook_harmonic_default_reflected (n k : Nat) (h : 0 < n) (σ : Nat) (hσ0 : (n) ≤ σ) : σ - (n) < σ - (k % n) := Nat.sub_lt_sub_left (Nat.lt_of_lt_of_le (textbook_harmonic_default n k h) hσ0) (textbook_harmonic_default n k h)
/-- the contrapositive of textbook_harmonic_default (examples: fold-harmonic, payload-hooks-collapse) -/
theorem textbook_harmonic_default_contrapositive (n k : Nat) : ¬ (k % n < n) → ¬ ((0 < n)) := fun hc hh => hc (textbook_harmonic_default n k hh)
/-- a role sees a part of every enum's superposition: the combinations it may choose and the ones it may not make all of them, and its harmonic default is always one it may choose; in the app one predicate, adminOf, reads the admin role for every access function (examples: fold-harmonic-rbac) -/
theorem textbook_rbac_options (allowed all : Nat) (h : allowed ≤ all) : all - allowed + allowed = all := Nat.sub_add_cancel h
/-- textbook_rbac_options reflected by its shape, equality (examples: fold-harmonic-rbac) -/
