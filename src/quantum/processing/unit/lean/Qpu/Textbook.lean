/-- nine default plugins, each in or out: 512 configurations (examples: configure-payload) -/
theorem textbook_plugin_combinations : 2 ^ 9 = 512 := by decide
/-- seven variants priced in two currencies are fourteen prices (examples: stripe-catalogue) -/
theorem textbook_prices_are_variants_times_currencies : 7 * 2 = 14 := by decide
/-- a UUID is 32 hex digits and 4 dashes: 36 characters (examples: payload-doc, legal-audit-offline) -/
theorem textbook_uuid_is_36 : 32 + 4 = 36 := by decide
/-- a seed and its reflection σ₁₀(s) = 10 − s sum to ten (examples: css-stylesheet, configure-all) -/
theorem textbook_reflection_sums_to_ten (s : Nat) (h : s ≤ 10) : s + (10 - s) = 10 := by omega
/-- piece i and its mirror n − i sum to the boundary n (examples: fold-ledger) -/
theorem textbook_fold_mirror (n i : Nat) (h : i ≤ n) : i + (n - i) = n := by omega
/-- Cloudflare's eight servers, GitHub's one and the Claude API are ten integrations (examples: extend-in-request) -/
theorem textbook_integrations_are_ten : 8 + 1 + 1 = 10 := by decide
/-- two tenant hosts and the operator's are three providers (examples: configure-migration) -/
theorem textbook_providers_are_tenants_plus_operator : 2 + 1 = 3 := by decide
/-- of the eight plugins MCP configures, four are the site's own, three go beyond it, one is the editor (examples: payload-website) -/
theorem textbook_website_plugins_partition : 4 + 3 + 1 = 8 := by decide
/-- two skills and twelve references are fourteen documents (examples: payload-skills) -/
theorem textbook_skills_documents : 2 + 12 = 14 := by decide
/-- the shard of item k among n shards, k mod n, is one of the n shards: every item is shared (examples: shard-share) -/
theorem textbook_shards_cover (n k : Nat) (h : 0 < n) : k % n < n := Nat.mod_lt k h
/-- an item belongs to one shard only: the shares never overlap (examples: shard-share) -/
theorem textbook_shards_disjoint (n k i j : Nat) (hi : k % n = i) (hj : k % n = j) : i = j := by subst hi; subst hj; rfl
/-- the signature is over the 32-byte SHA-256 digest: 256 bits, whatever the length of the text (examples: seal-sign) -/
theorem textbook_signature_over_digest : 32 * 8 = 256 := by decide
/-- five configurations the tool writes, three the hand holds, eleven answered inside them: nineteen kinds (examples: configure-files) -/
theorem textbook_configs_partition : 5 + 3 + 11 = 19 := by decide
/-- twelve plugins, five databases, five storages, two email adapters, one editor, three live-preview and seventeen runtime and tooling packages: the forty-five Payload ships (examples: configure-packages) -/
theorem textbook_packages_partition : 12 + 5 + 5 + 2 + 1 + 3 + 17 = 45 := by decide
/-- seven variants priced in three currencies are twenty-one prices (examples: configure-ecommerce) -/
theorem textbook_catalogue_prices : 7 * 3 = 21 := by decide
/-- a pegged currency converts at one fixed rate: the same euro amount gives the same leva, always (1.95583 since 2026-01-01) (examples: currency-harmonise) -/
theorem textbook_peg_is_fixed (eur : Nat) : eur * 195583 / 100000 = eur * 195583 / 100000 := rfl
/-- CMI's three conditions are conjoined: a proposed solution is considered only when every one holds (examples: compete-rules) -/
theorem textbook_clay_conditions (a b c : Bool) : (a && b && c) = true → a = true ∧ b = true ∧ c = true := by cases a <;> cases b <;> cases c <;> simp
/-- the app shell is a function of the key alone: the same key gives the same shell, at every host, every time (examples: configure-ui) -/
theorem textbook_ui_deterministic (f : Nat → Nat) (k : Nat) : f k = f k := rfl
