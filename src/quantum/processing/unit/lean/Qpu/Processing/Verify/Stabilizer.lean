import Qpu.Processing.CircuitBasedQuantumComputing

/-
  Qpu.Verify.Stabilizer — Pauli conjugation rules for the Clifford group,
  kernel-checked by `decide` on symplectic (x, z) bits. T-gate facts are
  delegated to the exact ℤ[ω] proof in `QuantumGate`.
-/
namespace Qpu.Verify.Stabilizer

/-- Single-qubit Pauli as symplectic bits: both set means Y. -/
structure P1 where
  x : Bool
  z : Bool
deriving DecidableEq, Repr

/-- Identity Pauli. -/
def pi : P1 := ⟨false, false⟩
/-- Pauli X. -/
def px : P1 := ⟨true, false⟩
/-- Pauli Y. -/
def py : P1 := ⟨true, true⟩
/-- Pauli Z. -/
def pz : P1 := ⟨false, true⟩

/-- Signed Pauli: `true` carries a minus sign. -/
abbrev Signed := Bool × P1

/-- Conjugation by H: X↔Z, Y ↦ −Y. Sign flips exactly when both bits are set. -/
def conjH (p : P1) : Signed := (p.x && p.z, ⟨p.z, p.x⟩)

/-- Conjugation by S: X ↦ Y, Y ↦ −X, Z ↦ Z. -/
def conjS (p : P1) : Signed := (p.x && p.z, ⟨p.x, p.x ^^ p.z⟩)

/-- Lift an unsigned-input conjugation rule to signed Paulis: preserve the
    incoming sign and XOR it with the sign generated by the gate. -/
def liftSigned (f : P1 → Signed) (v : Signed) : Signed :=
  let result := f v.2
  (v.1 ^^ result.1, result.2)

/-- Signed Hadamard conjugation. -/
def applySignedH : Signed → Signed :=
  liftSigned conjH

/-- Signed S conjugation. -/
def applySignedS : Signed → Signed :=
  liftSigned conjS

/-- Signed S† conjugation, implemented as three S conjugations. -/
def applySignedSdg (v : Signed) : Signed :=
  applySignedS (applySignedS (applySignedS v))

/-- The T gate is unitary, has order 8, and does not commute with Hadamard.
    This exact result is proved over ℤ[ω] in `QuantumGate`. -/
theorem stabilizer_t_gate :
    QuantumGate.SameW (QuantumGate.mmW QuantumGate.TW (QuantumGate.dagW QuantumGate.TW)) QuantumGate.idW ∧
    QuantumGate.SameW (QuantumGate.powW QuantumGate.TW 8) QuantumGate.idW ∧
    ¬ QuantumGate.SameW (QuantumGate.powW QuantumGate.TW 4) QuantumGate.idW ∧
    ¬ QuantumGate.SameW (QuantumGate.mmW QuantumGate.HW QuantumGate.TW)
      (QuantumGate.mmW QuantumGate.TW QuantumGate.HW) := QuantumGate.t_gate

/-- Positive control: T has order 8. -/
theorem test_t_order_is_eight :
    QuantumGate.SameW (QuantumGate.powW QuantumGate.TW 8)
      QuantumGate.idW :=
  QuantumGate.t_gate.2.1

/-- Negative control: T does not have order 4. -/
theorem test_t_order_is_not_four :
    ¬ QuantumGate.SameW (QuantumGate.powW QuantumGate.TW 4)
      QuantumGate.idW :=
  QuantumGate.t_gate.2.2.1

/-- Negative control: T does not commute with Hadamard. This distinguishes
    T from Clifford gates such as H, S, CNOT, and CZ. -/
theorem test_t_does_not_commute_with_hadamard :
    ¬ (QuantumGate.SameW
        (QuantumGate.mmW QuantumGate.HW QuantumGate.TW)
        (QuantumGate.mmW QuantumGate.TW QuantumGate.HW)) := by
  intro h
  exact (QuantumGate.t_gate.2.2.2 h).elim

/-- Conjugation by CNOT (control first): X on the control spreads to the
    target, Z on the target spreads to the control. No sign changes. -/
def conjCnot (ct : P1 × P1) : P1 × P1 :=
  (⟨ct.1.x, ct.1.z ^^ ct.2.z⟩, ⟨ct.1.x ^^ ct.2.x, ct.2.z⟩)

/-- Conjugation by SWAP: exchanges the two qubits' Pauli factors.
    SWAP·(P⊗Q)·SWAP = Q⊗P, with no sign change. -/
def conjSwap (ct : P1 × P1) : P1 × P1 :=
  (ct.2, ct.1)

/-- SWAP is an involution on every two-qubit Pauli pair. -/
theorem stabilizer_swap_involution (ct : P1 × P1) :
    conjSwap (conjSwap ct) = ct := by
  rcases ct with ⟨⟨a, b⟩, ⟨c, d⟩⟩
  cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- SWAP exchanges the two qubits' Pauli factors. -/
theorem stabilizer_swap_exchanges_factors (ct : P1 × P1) :
    conjSwap ct = (ct.2, ct.1) := rfl

/-- Signed two-qubit Pauli: one global phase sign plus the two Pauli bits. -/
abbrev Signed2 := Bool × P1 × P1

/-- Signed CNOT conjugation (control first): copies the control's X to the
    target, copies the target's Z to the control, and applies the Clifford
    phase correction `x_c · z_t · (x_t = z_c)`. -/
def conjCnotSigned (ct : P1 × P1) : Signed2 :=
  (ct.1.x && ct.2.z && (ct.2.x == ct.1.z),
   ⟨ct.1.x, ct.1.z ^^ ct.2.z⟩,
   ⟨ct.1.x ^^ ct.2.x, ct.2.z⟩)

/-- Signed CNOT conjugation: preserve the incoming global sign and XOR it with
    the CNOT-generated phase. -/
def applySignedCnot : Signed2 → Signed2 :=
  fun v =>
    let result := conjCnotSigned (v.2.1, v.2.2)
    (v.1 ^^ result.1, result.2.1, result.2.2)

/-- Conjugation by CZ: X supports are unchanged; each Z bit XORs in the
    other qubit's X bit. The sign flips exactly when both qubits have X
    support. -/
def conjCz (ct : P1 × P1) : Signed2 :=
  (ct.1.x && ct.2.x,
   ⟨ct.1.x, ct.1.z ^^ ct.2.x⟩,
   ⟨ct.2.x, ct.2.z ^^ ct.1.x⟩)

/-- Signed CZ conjugation: preserve the incoming global sign and XOR it with
    the CZ-generated phase. -/
def applySignedCz : Signed2 → Signed2 :=
  fun v =>
    let result := conjCz (v.2.1, v.2.2)
    (v.1 ^^ result.1, result.2.1, result.2.2)

/-- CZ is an involution on every signed two-qubit Pauli pair. -/
theorem stabilizer_cz_involution (ct : P1 × P1) :
    applySignedCz (conjCz ct) = (false, ct.1, ct.2) := by
  rcases ct with ⟨⟨a, b⟩, ⟨c, d⟩⟩
  cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- CZ preserves the X supports of both qubits. -/
theorem stabilizer_cz_x_support_rule (ct : P1 × P1) :
    (conjCz ct).2.1.x = ct.1.x ∧
    (conjCz ct).2.2.x = ct.2.x := by
  rcases ct with ⟨⟨a, b⟩, ⟨c, d⟩⟩
  cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- CZ updates each Z bit by XORing in the other qubit's X bit. -/
theorem stabilizer_cz_z_support_rule (ct : P1 × P1) :
    (conjCz ct).2.1.z = (ct.1.z ^^ ct.2.x) ∧
    (conjCz ct).2.2.z = (ct.2.z ^^ ct.1.x) := by
  rcases ct with ⟨⟨a, b⟩, ⟨c, d⟩⟩
  cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- CZ flips the sign exactly when both qubits have X support. -/
theorem stabilizer_cz_sign_rule (ct : P1 × P1) :
    (conjCz ct).1 = (ct.1.x && ct.2.x) := by
  rcases ct with ⟨⟨a, b⟩, ⟨c, d⟩⟩
  cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- CZ sends X⊗I to +X⊗Z. -/
theorem stabilizer_cz_xi :
    conjCz (px, pi) = (false, px, pz) := by
  decide

/-- CZ sends I⊗X to +Z⊗X. -/
theorem stabilizer_cz_ix :
    conjCz (pi, px) = (false, pz, px) := by
  decide

/-- CZ fixes Z⊗I. -/
theorem stabilizer_cz_zi :
    conjCz (pz, pi) = (false, pz, pi) := by
  decide

/-- CZ fixes I⊗Z. -/
theorem stabilizer_cz_iz :
    conjCz (pi, pz) = (false, pi, pz) := by
  decide

/-- CZ sends X⊗X to −Y⊗Y. -/
theorem stabilizer_cz_xx :
    conjCz (px, px) = (true, py, py) := by
  decide

/-- CZ sends X⊗Y to −Y⊗X. -/
theorem stabilizer_cz_xy :
    conjCz (px, py) = (true, py, px) := by
  decide

/-- CZ sends Y⊗X to −X⊗Y. -/
theorem stabilizer_cz_yx :
    conjCz (py, px) = (true, px, py) := by
  decide

/-- CZ sends Y⊗Y to −X⊗X. -/
theorem stabilizer_cz_yy :
    conjCz (py, py) = (true, px, px) := by
  decide

/-- CZ sends X⊗Z to +X⊗I. -/
theorem stabilizer_cz_xz :
    conjCz (px, pz) = (false, px, pi) := by
  decide

/-- CZ sends Z⊗X to +I⊗X. -/
theorem stabilizer_cz_zx :
    conjCz (pz, px) = (false, pi, px) := by
  decide

/-- CZ sends Y⊗Z to +Y⊗I. -/
theorem stabilizer_cz_yz :
    conjCz (py, pz) = (false, py, pi) := by
  decide

/-- CZ sends Z⊗Y to +I⊗Y. -/
theorem stabilizer_cz_zy :
    conjCz (pz, py) = (false, pi, py) := by
  decide

/-- CZ sends Y⊗I to +Y⊗Z. -/
theorem stabilizer_cz_yi :
    conjCz (py, pi) = (false, py, pz) := by
  decide

/-- CZ sends I⊗Y to +Z⊗Y. -/
theorem stabilizer_cz_iy :
    conjCz (pi, py) = (false, pz, py) := by
  decide

/-- CZ fixes Z⊗Z. -/
theorem stabilizer_cz_zz :
    conjCz (pz, pz) = (false, pz, pz) := by
  decide

/-- CZ fixes a two-qubit Pauli exactly when neither qubit has X support:
    an X on either qubit puts a Z on the other (CZ·(I⊗X)·CZ = Z⊗X). -/
theorem stabilizer_cz_commutation_rule (ct : P1 × P1) :
    (conjCz ct = (false, ct.1, ct.2)) ↔
      (ct.1.x = false ∧ ct.2.x = false) := by
  rcases ct with ⟨⟨a, b⟩, ⟨c, d⟩⟩
  cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- H·X·H = +Z. -/
theorem stabilizer_hadamard_x : conjH px = (false, pz) := by decide
/-- H·Z·H = +X. -/
theorem stabilizer_hadamard_z : conjH pz = (false, px) := by decide
/-- H·Y·H = −Y: the Hadamard is its own inverse with a sign on Y. -/
theorem stabilizer_hadamard_y : conjH py = (true, py) := by decide
/-- S·X·S† = +Y. -/
theorem stabilizer_phase_x : conjS px = (false, py) := by decide
/-- S·Y·S† = −X. -/
theorem stabilizer_phase_y : conjS py = (true, px) := by decide
/-- S·Z·S† = +Z: the phase gate commutes with Z. -/
theorem stabilizer_phase_z : conjS pz = (false, pz) := by decide
/-- CNOT sends X⊗I to X⊗X: the bit flip fans out control → target. -/
theorem stabilizer_cnot_xi : conjCnot (px, pi) = (px, px) := by decide
/-- CNOT fixes I⊗X. -/
theorem stabilizer_cnot_ix : conjCnot (pi, px) = (pi, px) := by decide
/-- CNOT fixes Z⊗I. -/
theorem stabilizer_cnot_zi : conjCnot (pz, pi) = (pz, pi) := by decide
/-- CNOT sends I⊗Z to Z⊗Z: the phase flip fans back target → control. -/
theorem stabilizer_cnot_iz : conjCnot (pi, pz) = (pz, pz) := by decide
/-- CNOT sends Y⊗I to Y⊗X with no sign change. -/
theorem stabilizer_cnot_yi : conjCnot (py, pi) = (py, px) := by decide
/-- Negative control: S sends Y to −X, never to +X. -/
theorem phase_y_is_not_plus_x : conjS py ≠ (false, px) := by decide

/-- Signed CNOT sends X⊗I to +X⊗X. -/
theorem stabilizer_cnot_signed_xi :
    conjCnotSigned (px, pi) = (false, px, px) := by decide
/-- Signed CNOT fixes I⊗X. -/
theorem stabilizer_cnot_signed_ix :
    conjCnotSigned (pi, px) = (false, pi, px) := by decide
/-- Signed CNOT fixes Z⊗I. -/
theorem stabilizer_cnot_signed_zi :
    conjCnotSigned (pz, pi) = (false, pz, pi) := by decide
/-- Signed CNOT sends I⊗Z to +Z⊗Z. -/
theorem stabilizer_cnot_signed_iz :
    conjCnotSigned (pi, pz) = (false, pz, pz) := by decide
/-- Signed CNOT sends Y⊗I to +Y⊗X. -/
theorem stabilizer_cnot_signed_yi :
    conjCnotSigned (py, pi) = (false, py, px) := by decide
/-- Signed CNOT sends I⊗Y to +Z⊗Y. -/
theorem stabilizer_cnot_signed_iy :
    conjCnotSigned (pi, py) = (false, pz, py) := by decide
/-- Signed CNOT sends Y⊗Y to −X⊗Z. -/
theorem stabilizer_cnot_signed_yy :
    conjCnotSigned (py, py) = (true, px, pz) := by decide
/-- Negative control: signed CNOT sends X⊗Y to +Y⊗Z, so its phase rule is
    not merely the unsigned rule with a constant sign. -/
theorem stabilizer_cnot_signed_xy :
    conjCnotSigned (px, py) = (false, py, pz) := by decide

/-- Signed CNOT preserves the incoming sign, XORs it with the CNOT phase, and
    applies the corrected Pauli-bit updates, for every signed two-qubit Pauli. -/
theorem test_signed_cnot_all_cases
    (sign : Bool) (pc pt : P1) :
    applySignedCnot (sign, pc, pt) =
      (sign ^^ (pc.x && pt.z && (pt.x == pc.z)),
       ⟨pc.x, pc.z ^^ pt.z⟩,
       ⟨pc.x ^^ pt.x, pt.z⟩) := by
  rcases pc with ⟨a, b⟩
  rcases pt with ⟨c, d⟩
  cases sign <;> cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- The signed CNOT rule agrees with the phase-aware matrix-level rule:
    same phase parity and same Pauli-bit updates. -/
theorem conjCnotSigned_agrees_with_ruleCNOT (k : Nat) (ct : P1 × P1) :
    CircuitBasedQuantumComputing.ruleCNOT
      ⟨k, ct.1.x, ct.1.z, ct.2.x, ct.2.z⟩ =
      ⟨(k + if (ct.1.x && ct.2.z && (ct.2.x == ct.1.z)) then 2 else 0) % 4,
       ct.1.x, ct.1.z ^^ ct.2.z,
       ct.1.x ^^ ct.2.x, ct.2.z⟩ := by
  rcases ct with ⟨⟨a, b⟩, ⟨c, d⟩⟩
  cases a <;> cases b <;> cases c <;> cases d <;> rfl

/-- The signed CNOT rule is exactly the rule appearing in the proved
    `Exact CNOT` proposition, with its Boolean phase encoding the parity of
    the rule's `i^k` phase. -/
theorem conjCnotSigned_matches_ruleCNOT (k : Nat) (ct : P1 × P1) :
    CircuitBasedQuantumComputing.ruleCNOT
      ⟨k, ct.1.x, ct.1.z, ct.2.x, ct.2.z⟩ =
      ⟨(k + if (conjCnotSigned ct).1 then 2 else 0) % 4,
       (conjCnotSigned ct).2.1.x, (conjCnotSigned ct).2.1.z,
       (conjCnotSigned ct).2.2.x, (conjCnotSigned ct).2.2.z⟩ := by
  rcases ct with ⟨⟨a, b⟩, ⟨c, d⟩⟩
  cases a <;> cases b <;> cases c <;> cases d <;> rfl

/-!
## Signed single-qubit conjugation regression tests

Automated exhaustive checks for all eight signed single-qubit Pauli inputs
for both `applySignedH` and `applySignedS`.
-/

/-- Signed Hadamard preserves or flips the incoming sign exactly as the
    unsigned H rule requires, for every signed Pauli input. -/
theorem test_signed_hadamard_all_cases (sign : Bool) (p : P1) :
    applySignedH (sign, p) =
      (sign ^^ (p.x && p.z), ⟨p.z, p.x⟩) := by
  rcases p with ⟨a, b⟩
  cases sign <;> cases a <;> cases b <;> decide

/-- Signed phase gate preserves or flips the incoming sign exactly as the
    unsigned S rule requires, for every signed Pauli input. -/
theorem test_signed_phase_all_cases (sign : Bool) (p : P1) :
    applySignedS (sign, p) =
      (sign ^^ (p.x && p.z), ⟨p.x, p.x ^^ p.z⟩) := by
  rcases p with ⟨a, b⟩
  cases sign <;> cases a <;> cases b <;> decide

/-- Signed Hadamard sends +X to +Z. -/
theorem test_signed_hadamard_plus_x :
    applySignedH (false, px) = (false, pz) := by
  decide

/-- Signed Hadamard sends −X to −Z. -/
theorem test_signed_hadamard_minus_x :
    applySignedH (true, px) = (true, pz) := by
  decide

/-- Signed Hadamard sends +Z to +X. -/
theorem test_signed_hadamard_plus_z :
    applySignedH (false, pz) = (false, px) := by
  decide

/-- Signed Hadamard sends −Z to −X. -/
theorem test_signed_hadamard_minus_z :
    applySignedH (true, pz) = (true, px) := by
  decide

/-- Signed Hadamard sends +Y to −Y. -/
theorem test_signed_hadamard_plus_y :
    applySignedH (false, py) = (true, py) := by
  decide

/-- Signed Hadamard sends −Y to +Y. -/
theorem test_signed_hadamard_minus_y :
    applySignedH (true, py) = (false, py) := by
  decide

/-- Signed phase gate sends +X to +Y. -/
theorem test_signed_phase_plus_x :
    applySignedS (false, px) = (false, py) := by
  decide

/-- Signed phase gate sends −X to −Y. -/
theorem test_signed_phase_minus_x :
    applySignedS (true, px) = (true, py) := by
  decide

/-- Signed phase gate sends +Y to −X. -/
theorem test_signed_phase_plus_y :
    applySignedS (false, py) = (true, px) := by
  decide

/-- Signed phase gate sends −Y to +X. -/
theorem test_signed_phase_minus_y :
    applySignedS (true, py) = (false, px) := by
  decide

/-- Signed phase gate fixes +Z. -/
theorem test_signed_phase_plus_z :
    applySignedS (false, pz) = (false, pz) := by
  decide

/-- Signed phase gate fixes −Z. -/
theorem test_signed_phase_minus_z :
    applySignedS (true, pz) = (true, pz) := by
  decide

/-- Negative control: signed Hadamard does not send −Y to −Y. -/
theorem test_signed_hadamard_minus_y_is_not_minus_y :
    applySignedH (true, py) ≠ (true, py) := by
  decide

/-- Negative control: signed phase gate does not send −Y to −X. -/
theorem test_signed_phase_minus_y_is_not_minus_x :
    applySignedS (true, py) ≠ (true, px) := by
  decide

/-!
## Signed CZ conjugation regression tests

Automated exhaustive checks for all 32 signed two-qubit Pauli inputs.
-/

/-- Signed CZ preserves the incoming sign, XORs it with the CZ phase, and
    applies the corrected Z-bit updates, for every signed two-qubit Pauli. -/
theorem test_signed_cz_all_cases
    (sign : Bool) (pc pt : P1) :
    applySignedCz (sign, pc, pt) =
      (sign ^^ (pc.x && pt.x),
       ⟨pc.x, pc.z ^^ pt.x⟩,
       ⟨pt.x, pt.z ^^ pc.x⟩) := by
  rcases pc with ⟨a, b⟩
  rcases pt with ⟨c, d⟩
  cases sign <;> cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- Signed CZ sends +X⊗I to +X⊗Z. -/
theorem test_signed_cz_plus_xi :
    applySignedCz (false, px, pi) = (false, px, pz) := by
  decide

/-- Signed CZ sends −X⊗I to −X⊗Z. -/
theorem test_signed_cz_minus_xi :
    applySignedCz (true, px, pi) = (true, px, pz) := by
  decide

/-- Signed CZ sends +X⊗X to −Y⊗Y. -/
theorem test_signed_cz_plus_xx :
    applySignedCz (false, px, px) = (true, py, py) := by
  decide

/-- Signed CZ sends −X⊗X to +Y⊗Y. -/
theorem test_signed_cz_minus_xx :
    applySignedCz (true, px, px) = (false, py, py) := by
  decide

/-- Negative control: signed CZ does not send −X⊗X to −Y⊗Y. -/
theorem test_signed_cz_minus_xx_is_not_minus_yy :
    applySignedCz (true, px, px) ≠ (true, py, py) := by
  decide

/-!
## CZ conjugation regression tests

Concrete tests for every two-qubit Pauli input to `conjCz`, including
negative tests for the four non-commuting X-support cases.
-/

/-- CZ fixes the identity Pauli pair. -/
theorem test_cz_identity :
    conjCz (pi, pi) = (false, pi, pi) := by
  decide

/-- CZ sends X⊗I to +X⊗Z. -/
theorem test_cz_xi :
    conjCz (px, pi) = (false, px, pz) := by
  decide

/-- CZ sends I⊗X to +Z⊗X. -/
theorem test_cz_ix :
    conjCz (pi, px) = (false, pz, px) := by
  decide

/-- CZ fixes Z⊗I. -/
theorem test_cz_zi :
    conjCz (pz, pi) = (false, pz, pi) := by
  decide

/-- CZ fixes I⊗Z. -/
theorem test_cz_iz :
    conjCz (pi, pz) = (false, pi, pz) := by
  decide

/-- CZ sends X⊗X to −Y⊗Y. -/
theorem test_cz_xx :
    conjCz (px, px) = (true, py, py) := by
  decide

/-- CZ sends X⊗Y to −Y⊗X. -/
theorem test_cz_xy :
    conjCz (px, py) = (true, py, px) := by
  decide

/-- CZ sends Y⊗X to −X⊗Y. -/
theorem test_cz_yx :
    conjCz (py, px) = (true, px, py) := by
  decide

/-- CZ sends Y⊗Y to −X⊗X. -/
theorem test_cz_yy :
    conjCz (py, py) = (true, px, px) := by
  decide

/-- CZ sends X⊗Z to +X⊗I. -/
theorem test_cz_xz :
    conjCz (px, pz) = (false, px, pi) := by
  decide

/-- CZ sends Z⊗X to +I⊗X. -/
theorem test_cz_zx :
    conjCz (pz, px) = (false, pi, px) := by
  decide

/-- CZ sends Y⊗Z to +Y⊗I. -/
theorem test_cz_yz :
    conjCz (py, pz) = (false, py, pi) := by
