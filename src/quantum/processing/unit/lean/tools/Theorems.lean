import Lean
import Qpu

/-! # Theorems

Lean writes the theorem index: every theorem the author declared (`Qpu.declaredTheorems`), with the statement the
kernel accepted, the axioms it rests on and its inline doc, and every module's doc. The TypeScript reads this index.

Run from the repository root: `lake env lean src/quantum/processing/unit/lean/tools/Theorems.lean`.
The index is written to `.lake/build/theorems-index.ts`; `lake run index` installs it and `lake run check` compares it. -/

open Lean Meta

/-- Where the rendered index is written. -/
def theoremsOut : System.FilePath := ".lake" / "build" / "theorems-index.ts"

#eval show MetaM Unit from do
  let env ← getEnv
  let declared ← Qpu.declaredTheorems
  let (all, compilerWritten) ← Qpu.theoremCounts
  let mut rows : Array String := #[]
  let mut sorried := 0
  for (name, module) in declared do
    let info ← getConstInfo name
    let statement ← ppExpr info.type
    let axioms ← collectAxioms name
    if axioms.contains ``sorryAx then sorried := sorried + 1
    let doc := ((← findDocString? env name).getD "").trimAscii.toString
    let fields : List (String × Json) :=
      [("key", .str name.toString), ("module", .str module.toString), ("statement", .str ((toString statement).replace "\n" " ")), ("axioms", .arr (axioms.map fun a => Json.str a.toString))]
      ++ (if doc.isEmpty then [] else [("doc", .str (doc.replace "\n" " "))])
    -- the fields in the order the readers know them
    rows := rows.push ("  {" ++ ", ".intercalate (fields.map fun (key, value) => s!"{(Json.str key).compress}: {value.compress}") ++ "},")
  if sorried > 0 then throwError s!"{sorried} declared theorem(s) rest on sorry: nothing is written"
  let mut docs : Array String := #[]
  for module in env.header.moduleNames do
    if (`Qpu).isPrefixOf module then
      if let some found := getModuleDoc? env module then
        docs := docs.push s!"  {(Json.str module.toString).compress}: {(Json.str ("\n".intercalate (found.toList.map (·.doc)))).compress},"
  let text := "\n".intercalate (
    [ "// GENERATED by lake run index from the Lean environment. Do not edit: Lean is the author and the kernel decides."
    , s!"export const KERNEL_THEOREMS = {all}"
    , s!"export const GENERATED_LEMMAS = {compilerWritten}"
    , "/** each theorem the author declared, with its statement, the axioms the kernel says it depends on, and its inline doc when it has one */"
    , "export const THEOREMS: readonly { key: string; module: string; statement: string; axioms: readonly string[]; doc?: string }[] = [" ]
    ++ rows.toList ++
    [ "]"
    , "export const THEOREM_KEYS: ReadonlySet<string> = new Set(THEOREMS.map((t) => t.key))"
    , "/** each Qpu module's doc, as the kernel environment holds it */"
    , "export const MODULE_DOCS: Readonly<Record<string, string>> = {" ]
    ++ docs.toList ++ [ "}", "" ])
  IO.FS.createDirAll (".lake" / "build")
  IO.FS.writeFile theoremsOut text
  IO.println s!"wrote {declared.size} declared theorem(s) of {all} kernel theorem(s), {compilerWritten} written by the compiler, to {theoremsOut}"
