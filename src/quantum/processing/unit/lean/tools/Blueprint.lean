import Lean
import Qpu

/-! # Blueprint

Lean writes the blueprint: one section for each module whose doc opens with frontmatter naming its component, with the
module's prose and a table of every theorem the author declared in that module and every theorem the prose names in
backticks, each with the statement the kernel accepted.

Run from the repository root: `lake env lean src/quantum/processing/unit/lean/tools/Blueprint.lean`.
The page is written to `.lake/build/BLUEPRINT.md`; `lake run index` installs it and `lake run check` compares it. -/

open Lean Meta

/-- Where the rendered page is written. -/
def blueprintOut : System.FilePath := ".lake" / "build" / "BLUEPRINT.md"

/-- The component a module doc names in its frontmatter, and the prose below it. -/
def component? (doc : String) : Option (String × String) :=
  match (doc.splitOn "\n").map (·.trimAscii.toString) |>.dropWhile (· == "") with
  | _title :: "---" :: rest =>
    let front := rest.takeWhile (· != "---")
    let prose := (rest.dropWhile (· != "---")).drop 1
    match front.find? (·.startsWith "component: ") with
    | some line => some ((line.drop "component: ".length).trimAscii.toString, (" ".intercalate prose).trimAscii.toString)
    | none => none
  | _ => none

/-- The names a prose puts in backticks. -/
def namedIn (prose : String) : List String :=
  let parts := prose.splitOn "`"
  (parts.zipIdx.filter fun (part, i) => i % 2 == 1 && !part.isEmpty && part.all (fun c => c.isAlphanum || c == '_' || c == '.')).map (·.1)

/-- One table cell: white space folded to single spaces, and a bar escaped. -/
def cell (text : String) : String :=
  (" ".intercalate ((text.split Char.isWhitespace).toList.map (·.toString) |>.filter (· != ""))).replace "|" "\\|"

#eval show MetaM Unit from do
  let env ← getEnv
  let declared ← Qpu.declaredTheorems
  let modules := (env.header.moduleNames.filter fun m => (`Qpu).isPrefixOf m).qsort (fun a b => a.toString < b.toString)
  let mut sections : Array String := #[]
  let mut components := 0
  let mut listed := 0
  for module in modules do
    let some docs := getModuleDoc? env module | continue
    let some (component, prose) := component? ("\n".intercalate (docs.toList.map (·.doc))) | continue
    components := components + 1
    let named := namedIn prose
    let rows := declared.filter fun (name, from_) => from_ == module || named.contains name.toString
    sections := sections.push s!"## {component}" |>.push "" |>.push s!"`{module}`. {prose}" |>.push ""
    if !rows.isEmpty then
      sections := sections.push "| Theorem | Module | Statement |" |>.push "|---|---|---|"
      for (name, from_) in rows do
        let statement ← ppExpr (← getConstInfo name).type
        sections := sections.push s!"| `{name}` | {from_} | `{cell (toString statement)}` |"
        listed := listed + 1
    sections := sections.push ""
  let head :=
    [ "<!-- GENERATED by lake run index from the Lean environment. Do not edit: Lean is the author. -->", ""
    , "# Blueprint of the qpu quantum computer design", "" ]
  IO.FS.createDirAll (".lake" / "build")
  IO.FS.writeFile blueprintOut ("\n".intercalate (head ++ sections.toList))
  IO.println s!"wrote {listed} theorem(s) across {components} component(s) to {blueprintOut}"
