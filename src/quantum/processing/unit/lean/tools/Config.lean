import Lean
import Qpu

/-! # Config

Lean writes the configuration the connector reads, from `Qpu.General.Config`. A formula whose witness is not a theorem
the author declared stops the run.

Run from the repository root: `lake env lean src/quantum/processing/unit/lean/tools/Config.lean`.
The index is written to `.lake/build/config-index.ts`; `lake run index` installs it and `lake run check` compares it. -/

open Lean Meta Config

/-- Where the rendered index is written. -/
def configOut : System.FilePath := ".lake" / "build" / "config-index.ts"

#eval show MetaM Unit from do
  let declared ← Qpu.declaredTheorems
  let strings (xs : List String) : String := (Json.arr (xs.map Json.str).toArray).compress
  let mut formulaFields : Array String := #[]
  for f in formulas do
    unless declared.any (·.1 == f.witness) do
      throwError "{f.witness} is named by a formula and is not a theorem the author declared"
    formulaFields := formulaFields.push s!"{f.name}: \{ theorem: {(Json.str f.witness.toString).compress}, params: {strings f.params} }"
  let text := "\n".intercalate
    [ "// GENERATED by lake run index from Qpu.General.Config. Do not edit: Lean is the author and the kernel decides."
    , "/** The formulas the connector solves, each with the theorem that states it. */"
    , s!"export const FORMULA = \{ {", ".intercalate formulaFields.toList} } as const"
    , "/** The primes a hexadecimal digit can hold, computed by Lean. */"
    , s!"export const NIBBLE_PRIMES = {(Json.arr (nibblePrimes.map fun n => Json.num n).toArray).compress} as const"
    , "/** The Payload plugins the connector expects to find mounted. */"
    , s!"export const OFFICIAL_PLUGINS = {strings officialPlugins} as const"
    , "/** The tools served first. */"
    , s!"export const CLAY_FIRST: readonly string[] = {strings clayFirst}"
    , "/** The most theorems one chat share carries. */"
    , s!"export const CHAT_SHARE = {chatShare}"
    , "/** The protocol version the connector answers initialize with. */"
    , s!"export const PROTOCOL_VERSION = {(Json.str protocolVersion).compress}"
    , "/** The address of the theorem ledger among the connector's resources. */"
    , s!"export const LEAN_RESOURCE = {(Json.str leanResource).compress}"
    , "/** The ways an operation is inserted into a circuit, and the one used when none is named. */"
    , s!"export const INSERT_SCHEMA = \{ enum: {strings insertStrategies}, default: {(Json.str insertDefault).compress} }"
    , "/** The coin qubit space, from Config.coinQubitSpace: the most remembered results a computation keeps at once. */"
    , s!"export const COIN_QUBIT_SPACE = {coinQubitSpace}"
    , "/** The groups of a UUID as it is written, from Advantage.uuidGroups: the hexadecimal digits between its dashes. */"
    , s!"export const UUID_GROUPS = {(Json.arr (Advantage.uuidGroups.map fun n => Json.num n).toArray).compress} as const"
    , "/** The shape of a UUID as a pattern, built from its groups; every check of a UUID in the code reads this one. */"
    , s!"export const UUID_SHAPE = {(Json.str ("-".intercalate (Advantage.uuidGroups.map fun n => "[0-9a-f]" ++ "{" ++ toString n ++ "}"))).compress}"
    , "" ]
  IO.FS.createDirAll (".lake" / "build")
  IO.FS.writeFile configOut text
  IO.println s!"wrote {formulas.length} formula(s), {nibblePrimes.length} prime(s) and {officialPlugins.length} plugin(s) to {configOut}"
