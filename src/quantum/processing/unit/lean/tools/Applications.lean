import Lean
import Qpu
import Qpu.Claims.Extract

/-! # Applications

Lean writes one draft application page for each theoretical use. A theoretical use is a module whose doc opens with
frontmatter (`component: …`); its page is made of that frontmatter, the module's prose, the claim context declared
beside its theorems when there is one, and every theorem of the module with its inline doc and its statement as the
kernel accepted it. Nothing on a page is typed outside Lean.

Run from the repository root: `lake env lean src/quantum/processing/unit/lean/tools/Applications.lean`.
The pages land in `site/patents/`, where the VitePress site reads them. -/

open Lean Meta

namespace Applications

/-- The directory the pages are written to, relative to the repository root. -/
def outDir : System.FilePath := "site" / "patents"

/-- A module doc split into its frontmatter pairs and its prose. -/
structure Use where
  /-- the Lean module -/
  module : Name
  /-- the `key: value` pairs between the `---` lines, in order -/
  front : List (String × String)
  /-- the prose below the frontmatter -/
  prose : String

/-- Read `# Module`, `---`, `key: value` lines, `---`, prose. A doc with no frontmatter is no theoretical use. -/
def parse (module : Name) (doc : String) : Option Use :=
  match (doc.splitOn "\n").map (·.trimAscii.toString) |>.dropWhile (· == "") with
  | _title :: "---" :: rest =>
    let front := rest.takeWhile (· != "---")
    let prose := (rest.dropWhile (· != "---")).drop 1
    let pairs := front.filterMap fun line =>
      match line.splitOn ": " with
      | key :: value :: more => some (key, ": ".intercalate (value :: more))
      | _ => none
    if pairs.isEmpty then none else some { module, front := pairs, prose := "\n".intercalate prose }
  | _ => none

/-- A file name made of the module's own name. -/
def slug (module : Name) : String :=
  (module.toString.replace "Qpu." "").replace "." "-" |>.toLower

/-- A YAML double-quoted scalar. -/
def yaml (text : String) : String :=
  "\"" ++ ((text.replace "\\" "\\\\").replace "\"" "\\\"").replace "\n" " " ++ "\""

/-- Text that Markdown and Vue read as text: braces and angle brackets are escaped. -/
def plain (text : String) : String :=
  (((text.replace "&" "&amp;").replace "<" "&lt;").replace ">" "&gt;").replace "{{" "&#123;&#123;"

/-- One theorem of a use: its name, inline doc and accepted statement. -/
structure Row where
  /-- the theorem's name -/
  name : Name
  /-- its inline doc, empty when it has none -/
  doc : String
  /-- its statement as the kernel accepted it -/
  statement : String

/-- The page of one use. -/
def page (use : Use) (claim : Option Qpu.Claim) (rows : Array Row) : String :=
  let component := (use.front.lookup "component").getD use.module.toString
  let title := (claim.map (·.context.title)).getD component
  let front :=
    [ "---"
    , s!"title: {yaml title}"
    , s!"description: {yaml component}"
    , s!"module: {use.module}"
    , "kind: application-draft"
    , "status: draft"
    , s!"theorems: {rows.size}" ]
    ++ use.front.map (fun (key, value) => s!"{key}: {yaml value}")
    ++ [ "---", "" ]
  let head :=
    [ s!"# {plain title}"
    , ""
    , "> Draft generated by Lean from the module's frontmatter, its inline docs and the theorems the kernel accepted."
    , "> It is not a filed application and not legal advice; a patent attorney decides what is claimed and filed."
    , ""
    , "## Technical field"
    , ""
    , plain ((claim.map (·.context.subject)).getD component)
    , "" ]
  let context := match claim with
    | none => []
    | some c =>
      [ "## Problem", "", plain c.context.problem, ""
      , "## Solution", "", plain c.context.solution, ""
      , "## Technical effect", "", plain c.context.technicalEffect, ""
      , "## Assertion", "", plain c.context.assertion, ""
      , s!"Kind: {c.context.kind.toString}. Hardware: {c.context.hardware}. Evidence: "
          ++ ", ".intercalate (c.context.evidence.map fun e => s!"`{e}`") ++ ".", "" ]
  let description := [ "## Description", "", plain use.prose, "" ]
  let statements :=
    [ "## Statements the kernel accepted", "" ]
    ++ (rows.toList.zipIdx.flatMap fun (row, index) =>
      [ s!"### {index + 1}. `{row.name}`", "" ]
      ++ (if row.doc.isEmpty then [] else [ plain row.doc.trimAscii.toString, "" ])
      ++ [ "```lean", row.statement, "```", "" ])
  "\n".intercalate (front ++ head ++ context ++ description ++ statements)

/-- Write every page and the index that lists them. -/
def write : MetaM Unit := do
  let env ← getEnv
  let declared ← Qpu.declaredTheorems
  IO.FS.createDirAll outDir
  let mut index : Array (String × String × Nat) := #[]
  let modules := env.header.moduleNames.qsort (fun a b => a.toString < b.toString)
  for module in modules do
    unless (`Qpu).isPrefixOf module do continue
    let some docs := getModuleDoc? env module | continue
    let some use := parse module ("\n".intercalate (docs.toList.map (·.doc))) | continue
    let some idx := env.getModuleIdx? module | continue
    let names := (declared.filter fun (_, from_) => from_ == module).map (·.1)
    let mut rows : Array Row := #[]
    for name in names do
      let info ← getConstInfo name
      let statement ← ppExpr info.type
      let doc := (← findDocString? env name).getD ""
      rows := rows.push { name, doc, statement := toString statement }
    let source := "src/quantum/processing/unit/lean/" ++ (module.toString.replace "." "/") ++ ".lean"
    let claim := Qpu.Claims.Extract.claims.find? (·.source == source)
    IO.FS.writeFile (outDir / (slug module ++ ".md")) (page use claim rows)
    let component := (use.front.lookup "component").getD module.toString
    index := index.push (slug module, (claim.map (·.context.title)).getD component, rows.size)
  let lines :=
    [ "---", "title: \"Draft applications\"", "description: \"One draft per theoretical use, written by Lean\"", "---", ""
    , "# Draft applications", ""
    , "Lean writes one draft for each module whose doc carries frontmatter. Each is a draft, not a filed application.", ""
    , "| Use | Theorems |", "|---|---:|" ]
    ++ index.toList.map (fun (file, title, count) => s!"| [{plain title}](./{file}.md) | {count} |")
    ++ [ "" ]
  IO.FS.writeFile (outDir / "index.md") ("\n".intercalate lines)
  IO.println s!"wrote {index.size} draft application(s) to {outDir}"

end Applications

#eval Applications.write
