import Lean
import Qpu
import Qpu.General.Combinatorics

/-! # Nested

Lean writes the nested catalogue: the tree the site and the shop are made of, read from the Lean environment.
A clause folder is a page; a module is a page nested under its clause; a theorem is a product of its module's page;
and each example a textbook theorem names in its inline doc (`(examples: a, b)`) is a variant of that product.
A module is a textbook, its clause the ISO context and the module itself the scientific context. Textbooks mix two at a
time: Lean's own `choose` counts the mixes, and a mix varies every product of one textbook with every product of the other.
They mix in trinities too, three at a time, counted the same way.

Run from the repository root: `lake env lean src/quantum/processing/unit/lean/tools/Nested.lean`.
The index is written to `.lake/build/nested-index.ts`; `lake run index` installs it and `lake run check` compares it. -/

open Lean Meta

/-- Where the rendered index is written. -/
def nestedOut : System.FilePath := ".lake" / "build" / "nested-index.ts"

/-- The examples a theorem's inline doc names, in order. -/
def examplesOf (doc : String) : List String :=
  match doc.splitOn "(examples: " with
  | _ :: rest@(_ :: _) =>
    let named := (rest.getLast!.splitOn ")").head!
    if named == "none yet" then [] else named.splitOn ", "
  | _ => []

/-- A theorem that reflects another (its `_reflected`, `_contrapositive` or `_converse` form) is that product's own, not a product. -/
def reflects (name : String) : Bool :=
  ["_reflected", "_contrapositive", "_converse", "_converse_refuted"].any fun ending => name.endsWith ending

#eval show MetaM Unit from do
  let env ← getEnv
  let declared ← Qpu.declaredTheorems
  let modules := (env.header.moduleNames.filter fun m => (`Qpu).isPrefixOf m && m != `Qpu).qsort (fun a b => a.toString < b.toString)
  let mut rows : Array Json := #[]
  let mut products := 0
  let mut variants := 0
  for module in modules do
    -- a product is a theorem the author declared; the theorems that reflect it are its own, not products
    let names := (declared.filter fun (name, from_) => from_ == module && !reflects name.toString).map (·.1)
    let mut items : Array Json := #[]
    for name in names do
      let examples := examplesOf ((← findDocString? env name).getD "")
      products := products + 1
      variants := variants + examples.length
      items := items.push (Json.mkObj [("theorem", .str name.toString), ("variants", .arr (examples.map Json.str).toArray)])
    let parts := module.toString.splitOn "."
    let clause := parts.getD 1 ""
    rows := rows.push (Json.mkObj [("module", .str module.toString), ("clause", .str clause), ("products", .arr items)])
  -- the mixes: Lean's own `choose` counts the textbooks two at a time, and each mix varies every product of one
  -- textbook with every product of the other, a product with no example counting as its one variation
  let textbooks := rows.size
  let mixes := choose textbooks 2
  let weights := rows.map fun row =>
    match row.getObjValAs? (Array Json) "products" with
    | .ok items => items.foldl (fun n item => n + (match item.getObjValAs? (Array Json) "variants" with | .ok vs => max 1 vs.size | .error _ => 1)) 0
    | .error _ => 0
  let total := weights.foldl (· + ·) 0
  let squares := weights.foldl (fun n w => n + w * w) 0
  let mixed := (total * total - squares) / 2
  -- the trinities: three textbooks at a time, again by Lean's own `choose`; their variations are the products of three
  -- weights over every trinity, which the power sums give without listing them: (s1³ − 3·s1·s2 + 2·s3) / 6
  let trinities := choose textbooks 3
  let cubes := weights.foldl (fun n w => n + w * w * w) 0
  let trinityVariations := (total * total * total + 2 * cubes - 3 * total * squares) / 6
  -- a trinity is two pairs interacting as one: they share one textbook. Choose the shared textbook, then the pair of
  -- the other two; each triple forms three trinities, one for each textbook its two pairs can share
  let pairedTrinities := textbooks * choose (textbooks - 1) 2
  let pairedVariations := 3 * trinityVariations
  let lines := rows.toList.map fun row => s!"  {row.compress},"
  let text := "\n".intercalate (
    [ "// GENERATED by lake run index from the Lean environment. Do not edit: Lean is the author."
    , "/** The nested catalogue: each module is a page under its clause, each theorem a product, each textbook example a variant. */"
    , "export const NESTED: readonly { module: string; clause: string; products: readonly { theorem: string; variants: readonly string[] }[] }[] = [" ]
    ++ lines ++
    [ "]"
    , "/** What Lean counts: the textbooks, their mixes two at a time by Lean's own `choose`, and the variations a product has alone and mixed. */"
    , s!"export const NESTED_COUNTS = \{ textbooks: {textbooks}, mixes: {mixes}, products: {products}, variants: {variants}, variations: '{total}', mixedVariations: '{mixed}', trinities: {trinities}, trinityVariations: '{trinityVariations}', pairedTrinities: {pairedTrinities}, pairedVariations: '{pairedVariations}' } as const"
    , "" ])
  IO.FS.createDirAll (".lake" / "build")
  IO.FS.writeFile nestedOut text
  IO.println s!"wrote {rows.size} module page(s), {products} product(s) and {variants} variant(s) to {nestedOut}"
