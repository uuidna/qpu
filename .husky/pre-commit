#!/bin/sh
# Pre-commit hook: Enforce CC-BY-NC-ND-4.0 license compliance

set -e

echo "🔐 Checking license compliance..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

VIOLATIONS=0

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

# Check for prohibited licenses
echo "📋 Scanning for prohibited licenses..."
for file in $STAGED_FILES; do
  if [[ ! "$file" =~ \.(ts|js|json|md|yaml|yml)$ ]]; then
    continue
  fi

  # Check for MIT license
  if git show ":$file" | grep -qi "MIT\|mit license"; then
    echo -e "${RED}❌ $file: MIT license detected (prohibited)${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # Check for Apache license
  if git show ":$file" | grep -qi "Apache\|apache license"; then
    echo -e "${RED}❌ $file: Apache license detected (prohibited)${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # Check for GPL license
  if git show ":$file" | grep -qi "GPL\|gnu public license"; then
    echo -e "${RED}❌ $file: GPL license detected (prohibited)${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # Check for other licenses (BSD, ISC, MPL, etc.)
  if git show ":$file" | grep -qiE "BSD|ISC license|Mozilla Public|MPL"; then
    echo -e "${RED}❌ $file: Alternative license detected (prohibited)${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi
done

# Check for commercial markers
echo "🏢 Scanning for commercial violations..."
for file in $STAGED_FILES; do
  if [[ ! "$file" =~ \.(ts|js)$ ]]; then
    continue
  fi

  # Check for commercial payment processors (except test/demo)
  if git show ":$file" | grep -qi "stripe\|paypal\|square\|braintree"; then
    if ! git show ":$file" | grep -qi "test\|demo\|example"; then
      echo -e "${YELLOW}⚠️  $file: Commercial payment processor found (check licensing)${NC}"
    fi
  fi
done

# Check for derivative modifications in core files
echo "🔄 Checking for derivative violations..."
CORE_FILES=(
  "src/mcp/formula-kernel.ts"
  "src/mcp/autonomous-wave.ts"
  "src/quantum/processing/unit/index.ts"
)

for core_file in "${CORE_FILES[@]}"; do
  if [[ " $STAGED_FILES " =~ " $core_file " ]]; then
    # Check if it's a significant modification (not just whitespace/comments)
    DIFF_LINES=$(git diff --cached "$core_file" | grep -E "^\+" | grep -v "^+++" | wc -l)
    if [ "$DIFF_LINES" -gt 10 ]; then
      echo -e "${YELLOW}⚠️  $core_file: Significant modifications detected (verify no derivatives created)${NC}"
    fi
  fi
done

# Verify license text in critical files
echo "✍️  Verifying license documentation..."
if [[ " $STAGED_FILES " =~ "package.json" ]]; then
  if ! git show ":package.json" | grep -q '"license": "CC-BY-NC-ND-4.0"'; then
    echo -e "${RED}❌ package.json: Must have license: CC-BY-NC-ND-4.0${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi
fi

if [[ " $STAGED_FILES " =~ "LICENSE" ]]; then
  if ! git show ":LICENSE" | grep -q "CC BY-NC-ND 4.0"; then
    echo -e "${RED}❌ LICENSE: Must reference CC BY-NC-ND 4.0${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi
fi

# Check for attribution removal
echo "👤 Verifying attribution..."
if [[ " $STAGED_FILES " =~ "README" ]] || [[ " $STAGED_FILES " =~ "CITATION" ]]; then
  if git show ":package.json" | grep -q '"author"'; then
    AUTHOR=$(git show ":package.json" | grep '"name":' | head -1 | grep -o '"[^"]*"' | tr -d '"')
    if [[ -z "$AUTHOR" ]] || [[ "$AUTHOR" != "Tsvetan Rouschev" ]]; then
      echo -e "${YELLOW}⚠️  Attribution check: Verify author is correct${NC}"
    fi
  fi
fi

# Summary
echo ""
if [ $VIOLATIONS -eq 0 ]; then
  echo -e "${GREEN}✅ License compliance check passed${NC}"
  exit 0
else
  echo -e "${RED}❌ License compliance check failed: $VIOLATIONS violation(s) found${NC}"
  echo ""
  echo "This project uses CC-BY-NC-ND-4.0 license:"
  echo "  ✅ Non-commercial use only"
  echo "  ✅ Attribution required (Tsvetan Rouschev)"
  echo "  ✅ No derivatives allowed"
  echo "  ❌ No other licenses permitted"
  echo ""
  exit 1
fi
