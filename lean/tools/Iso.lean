import Lean
import Qpu

/-! # Iso

Lean writes the register of standards the code reads: the groups and terms of ISO/IEC 4879:2024, each term with the
theorem that witnesses it and that theorem's statement as the kernel accepted it, and every standard the tree names,
each with its witness or marked open. A witness that is not a theorem the author declared stops the run: the register
cannot be written with a clause the kernel does not carry.

Run from the repository root: `lake env lean lean/tools/Iso.lean`.
The index is written to `.lake/build/iso-index.ts`; `lake run index` installs it and `lake run check` compares it. -/

open Lean Meta Iso

/-- Where the rendered index is written. -/
def isoOut : System.FilePath := ".lake" / "build" / "iso-index.ts"

#eval show MetaM Unit from do
  let declared ← Qpu.declaredTheorems
  -- a witness is a theorem the author declared: its name, its module and its statement
  let witnessed (name : Name) : MetaM (List (String × Json)) := do
    let some (_, module) := declared.find? (·.1 == name)
      | throwError "{name} is named as a witness and is not a theorem the author declared"
    let statement ← ppExpr (← getConstInfo name).type
    return [("witness", .str name.toString), ("module", .str module.toString), ("statement", .str (toString statement))]
  let mut clauseRows : Array Json := #[]
  for c in clauses do
    let sentence := s!"Clause {c.number} of {vocabulary}, {c.name}, is witnessed by the theorem {c.witness}, which the kernel accepted."
    clauseRows := clauseRows.push (Json.mkObj ([("clause", .str c.number), ("name", .str c.name), ("check", .str c.check), ("says", .str sentence)] ++ (← witnessed c.witness)))
  let mut standardRows : Array Json := #[]
  let mut open_ := 0
  for s in standards do
    match s.witness with
    | some name =>
      let sentence := s!"{s.reference} is witnessed by the theorem {name}, which states a fact the standard fixes and which the kernel accepted."
      standardRows := standardRows.push (Json.mkObj ([("reference", .str s.reference), ("says", .str sentence)] ++ (← witnessed name)))
    | none =>
      open_ := open_ + 1
      let sentence := s!"{s.reference} is named by the tree and no theorem states a fact it fixes yet: it is open, a theorem still to prove."
      standardRows := standardRows.push (Json.mkObj [("reference", .str s.reference), ("says", .str sentence), ("witness", .null)])
  let groupRows := groups.map fun (g, title, n) => Json.mkObj [("group", .str s!"3.{g}"), ("title", .str title), ("terms", .num n)]
  let references := Json.arr (standards.map fun s => Json.str s.reference).toArray
  let sentence := s!"The tree names {standards.length} standards: {standards.length - open_} have a theorem that states a fact the standard fixes, and {open_} are open. Each of the {clauses.length} terms of {vocabulary} has a theorem the kernel accepted."
  let text := "\n".intercalate (
    [ "// GENERATED by lake run index from Qpu.General.Iso. Do not edit: Lean is the author and the kernel decides."
    , "/** The vocabulary standard whose terms the register holds. */"
    , s!"export const ISO_VOCABULARY = {(Json.str vocabulary).compress} as const"
    , "/** What the register holds, in Lean's own counts. */"
    , s!"export const ISO_SAYS = {(Json.str sentence).compress}"
    , "/** The groups of the vocabulary standard, each with the number of its terms. */"
    , s!"export const ISO_GROUPS: readonly \{ group: string; title: string; terms: number }[] = {(Json.arr groupRows.toArray).compress}"
    , "/** Every term of the vocabulary standard: its clause, its name, the check the processor runs for it, and the theorem that witnesses it with its statement. */"
    , "export const ISO_CLAUSES: readonly { clause: string; name: string; check: string; says: string; witness: string; module: string; statement: string }[] = [" ]
    ++ clauseRows.toList.map (fun row => s!"  {row.compress},") ++
    [ "]"
    , "/** Every standard the tree names, in the order Lean lists them. */"
    , s!"export const ISO_DIMENSIONS = {references.compress} as const"
    , "/** Every standard the tree names, with the theorem that states a fact it fixes; a standard whose witness is null is open: a theorem still to prove. */"
    , "export const ISO_STANDARDS: readonly { reference: string; says: string; witness: string | null; module?: string; statement?: string }[] = [" ]
    ++ standardRows.toList.map (fun row => s!"  {row.compress},") ++ [ "]", "" ])
  IO.FS.createDirAll (".lake" / "build")
  IO.FS.writeFile isoOut text
  IO.println s!"wrote {clauseRows.size} clause(s), all witnessed, and {standardRows.size} standard(s), {open_} open, to {isoOut}"
