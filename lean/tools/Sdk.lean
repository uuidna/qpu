import Lean
import Qpu

/-! # Sdk

Lean writes the harmonized Payload, VitePress, Cloudflare and MCP client-tool SDK contracts from `Qpu.General.Config`
and `Qpu.General.Iso`. Every collection name, variant type, relation map, Worker route, API prefix and TypeScript type
is authored here once so Payload clients, VitePress builds, Cloudflare Workers and client MCP tools share one schema.

Run from the repository root: `lake env lean lean/tools/Sdk.lean`.
The index is written to `.lake/build/sdk-index.ts`; `lake run index` installs it at `src/quantum/uuid/programs/sdk/schema/index.ts`
and `lake run check` compares it. -/

open Lean Config

/-- Where the rendered SDK index is written. -/
def sdkOut : System.FilePath := ".lake" / "build" / "sdk-index.ts"

private def tsStrings (xs : List String) : String :=
  (Json.arr (xs.map Json.str).toArray).compress

#eval show IO Unit from do
  let text := "\n".intercalate
    [ "// GENERATED by lake run index from Qpu.General.Config and Qpu.General.Iso (lean/tools/Sdk.lean). Do not edit: Lean is the author."
    , "/** The Payload ecommerce collections seeded in order, from Config.catalogCollections. */"
    , s!"export const CATALOG_COLLECTIONS = {tsStrings catalogCollections} as const"
    , "export type CatalogCollection = (typeof CATALOG_COLLECTIONS)[number]"
    , "/** The variant types every theorem product carries, from Config.catalogVariantTypes. */"
    , s!"export const CATALOG_VARIANT_TYPES = {tsStrings catalogVariantTypes} as const"
    , "export type CatalogVariantType = (typeof CATALOG_VARIANT_TYPES)[number]"
    , "/** Lean prover duality poles on every theorem product, from Config.proverDualities. */"
    , s!"export const PROVER_DUALITIES = {tsStrings proverDualities} as const"
    , "export type ProverDuality = (typeof PROVER_DUALITIES)[number]"
    , "/** Every collection the harmonized Payload and VitePress SDK serves through Cloudflare, from Config.sdkCollections. */"
    , s!"export const SDK_COLLECTIONS = {tsStrings sdkCollections} as const"
    , "export type SdkCollection = (typeof SDK_COLLECTIONS)[number]"
    , "/** Every Payload Global served through standard /api/globals/{slug}, from Config.sdkGlobals. */"
    , s!"export const SDK_GLOBALS = {tsStrings sdkGlobals} as const"
    , "export type SdkGlobal = (typeof SDK_GLOBALS)[number]"
    , "/** The routes the Cloudflare Worker handles first, from Config.workerRoutes. */"
    , s!"export const WORKER_ROUTES = {tsStrings workerRoutes} as const"
    , "/** Every Payload CMS v3 UI possibility surfaced by the Post-Quantum Payload Studio, from Config.payloadUiPossibilities. */"
    , s!"export const PAYLOAD_UI_POSSIBILITIES = {tsStrings payloadUiPossibilities} as const"
    , "export type PayloadUiPossibility = (typeof PAYLOAD_UI_POSSIBILITIES)[number]"
    , "/** NIST FIPS 203, 204, 205 and X-Wing post-quantum cryptography algorithms, from Config.pqcAlgorithms. */"
    , s!"export const PQC_ALGORITHMS = {tsStrings pqcAlgorithms} as const"
    , "export type PqcAlgorithm = (typeof PQC_ALGORITHMS)[number]"
    , "/** The Payload REST prefix served by Cloudflare and emitted for VitePress static assets. */"
    , "export const SDK_API_PREFIX = '/api' as const"
    , "/** The normative vocabulary identifier from Iso.vocabulary. */"
    , s!"export const SDK_VOCABULARY = {(Json.str Iso.vocabulary).compress} as const"
    , "/** Relation fields on each catalog collection whose values reference a document of an earlier collection. */"
    , "export const CATALOG_RELATIONS: Record<CatalogCollection, readonly string[]> = {"
    , "  variantTypes: [],"
    , "  variantOptions: ['variantType'],"
    , "  products: ['variantTypes'],"
    , "  variants: ['product', 'options', 'targetProduct'],"
    , "}"
    , "/** CORS headers shared by the Cloudflare Worker SDK handler and VitePress _headers. */"
    , "export const SDK_CORS_HEADERS: Readonly<Record<string, string>> = {"
    , "  'access-control-allow-origin': '*',"
    , "  'access-control-allow-methods': 'GET, POST, OPTIONS',"
    , "  'access-control-allow-headers': 'Content-Type, If-None-Match',"
    , "  'access-control-expose-headers': 'ETag',"
    , "  'cache-control': 'public, max-age=3600',"
    , "}"
    , "export type PayloadRelationId = string | number"
    , "export type PayloadStatus = 'draft' | 'published'"
    , "/** One sealed catalog document: id is the UUID of its collection and canonical data. */"
    , "export type CatalogDoc<C extends string = string, D extends Record<string, unknown> = Record<string, unknown>> = { collection: C; id: string; data: D }"
    , "/** A Payload REST record: the sealed UUID id beside the document's fields. */"
    , "export type PayloadRecord<D extends Record<string, unknown> = Record<string, unknown>> = { id: string } & D"
    , "/** A paginated Payload REST find response. */"
    , "export type PayloadPaginated<D extends Record<string, unknown> = Record<string, unknown>> = {"
    , "  docs: PayloadRecord<D>[]"
    , "  totalDocs: number"
    , "  limit: number"
    , "  totalPages: number"
    , "  page: number"
    , "  pagingCounter: number"
    , "  hasPrevPage: boolean"
    , "  hasNextPage: boolean"
    , "  prevPage: number | null"
    , "  nextPage: number | null"
    , "}"
    , "/** A product or entanglement variant packaged as an executable client MCP tool. */"
    , "export type McpClientTool = {"
    , "  name: string"
    , "  title: string"
    , "  description: string"
    , "  kind: 'witness' | 'entanglement' | 'duality'"
    , "  variantId?: string"
    , "  productId: string"
    , "  theorem: string"
    , "  targetTheorem?: string"
    , "  targetProductId?: string"
    , "  direction?: 'uses' | 'usedBy'"
    , "  duality?: ProverDuality"
    , "  proverVerdict?: 'accept' | 'reject'"
    , "  inputSchema: Record<string, unknown>"
    , "  annotations: { title: string; readOnlyHint: true; idempotentHint: true; openWorldHint: false }"
    , "  call: { method: 'tools/call'; params: { name: string; arguments: Record<string, unknown> } }"
    , "  rest: { method: 'POST'; path: string; body: Record<string, unknown> }"
    , "}"
    , "export type VariantTypeData = { name: CatalogVariantType; label: string }"
    , "export type VariantOptionData = { variantType: string; label: string; value: string }"
    , "export type ProductData = {"
    , "  title: string"
    , "  enableVariants: true"
    , "  variantTypes: string[]"
    , "  _status: PayloadStatus"
    , "  theorem: string"
    , "  module: string"
    , "  statement: string"
    , "  entanglementCount: number"
    , "  vitepressPath?: string"
    , "}"
    , "export type VariantData = {"
    , "  title: string"
    , "  kind: 'witness' | 'entanglement' | 'duality'"
    , "  product: string"
    , "  options: string[]"
    , "  _status: PayloadStatus"
    , "  address: string"
    , "  example?: string"
    , "  tool?: string"
    , "  witness?: string"
    , "  targetTheorem?: string"
    , "  targetProduct?: string"
    , "  direction?: 'uses' | 'usedBy'"
    , "  duality?: ProverDuality"
    , "  proverVerdict?: 'accept' | 'reject'"
    , "  proverCode?: string"
    , "  mcpTool: McpClientTool"
    , "}"
    , "export type ComputationData = {"
    , "  title: string"
    , "  tool: string"
    , "  toolbox: string"
    , "  address: string"
    , "  arguments: Record<string, unknown>"
    , "  theorem?: string"
    , "  result?: unknown"
    , "  licence: string"
    , "  standard: string"
    , "  vitepressPath: string"
    , "  mcpTool: { name: string; arguments: Record<string, unknown> }"
    , "}"
    , "export type StandardData = {"
    , "  reference: string"
    , "  title: string"
    , "  says: string"
    , "  witness: string | null"
    , "  vitepressPath: string"
    , "}"
    , "export type ClauseData = {"
    , "  clause: string"
    , "  name: string"
    , "  says: string"
    , "  witness: string | null"
    , "  standard: string"
    , "  vitepressPath: string"
    , "}"
    , "export type SdkDocMap = {"
    , "  variantTypes: VariantTypeData"
    , "  variantOptions: VariantOptionData"
    , "  products: ProductData"
    , "  variants: VariantData"
    , "  computations: ComputationData"
    , "  standards: StandardData"
    , "  clauses: ClauseData"
    , "}"
    , "/** Minimal Payload SDK create interface shared with @payloadcms/sdk and Local API. */"
    , "export type CatalogSdk = {"
    , "  create: (args: { collection: string; data: Record<string, unknown> }) => Promise<{ id: PayloadRelationId }>"
    , "}"
    , "/** Harmonized @payloadcms/sdk client interface: standard Payload collections, globals, and MCP UI connector. */"
    , "export type PayloadSdkClient = CatalogSdk & {"
    , "  find: <C extends SdkCollection>(args: { collection: C; page?: number; limit?: number }) => Promise<PayloadPaginated<SdkDocMap[C]>>"
    , "  findByID: <C extends SdkCollection>(args: { collection: C; id: string }) => Promise<PayloadRecord<SdkDocMap[C]> & Record<string, unknown>>"
    , "  findGlobal: <G extends SdkGlobal>(args: { slug: G; query?: Record<string, string | number> }) => Promise<Record<string, unknown>>"
    , "  updateGlobal: <G extends SdkGlobal>(args: { slug: G; data: Record<string, unknown> }) => Promise<Record<string, unknown>>"
    , "  mcp: (method: string, params?: Record<string, unknown>) => Promise<Record<string, unknown>>"
    , "}"
    , "/** Typed VitePress dynamic route parameters for catalog product pages. */"
    , "export type CatalogRouteParams = {"
    , "  product: string"
    , "  theorem: string"
    , "  module: string"
    , "  statement: string"
    , "  variants: string"
    , "  entanglements: string"
    , "}"
    , "export type VitePressRouteDoc<P extends Record<string, string> = CatalogRouteParams> = { params: P; content: string }"
    , "export type VitePressSidebarItem = { text: string; link: string }"
    , "export type VitePressSidebarGroup = { text: string; collapsed: boolean; items: VitePressSidebarItem[] }"
    , "export type VitePressPageDoc = { title: string; url: string; description: string; section: string }"
    , "/** Harmonized Cloudflare Worker environment shared by worker.ts and SDK handlers. */"
    , "export type CloudflareWorkerEnv<M = unknown, P = unknown> = Record<string, unknown> & {"
    , "  ASSETS: { fetch: (request: Request) => Promise<Response> }"
    , "  MAILBOX: M"
    , "  PROVER: P"
    , "}"
    , "/** One Payload UI possibility mapped onto the Post-Quantum Studio. */"
    , "export type PayloadUiPossibilityRow = {"
    , "  id: PayloadUiPossibility"
    , "  category: 'shell' | 'views' | 'list' | 'edit' | 'fields' | 'overlays' | 'platform'"
    , "  used: true"
    , "  surface: string"
    , "  view: 'dashboard' | 'collections' | 'pqc' | 'entanglement' | 'builder' | 'possibilities'"
    , "}"
    , "/** Payload CMS v3 field descriptor emitted for each SDK collection. */"
    , "export type PayloadUiFieldSpec = {"
    , "  name: string"
    , "  type: 'text' | 'code' | 'json' | 'select' | 'number' | 'checkbox' | 'relationship' | 'join' | 'array' | 'group' | 'row' | 'tabs' | 'blocks' | 'collapsible' | 'richText' | 'ui'"
    , "  position?: 'main' | 'sidebar'"
    , "  relationTo?: SdkCollection"
    , "}"
    , "/** Payload CMS v3 collection UI config derived from Lean SDK collections. */"
    , "export type PayloadUiCollectionSpec = {"
    , "  slug: SdkCollection"
    , "  group: string"
    , "  useAsTitle: string"
    , "  defaultColumns: string[]"
    , "  listSearchableFields: string[]"
    , "  versions: { drafts: true; autosave: true }"
    , "  totalDocs: number"
    , "  fields: PayloadUiFieldSpec[]"
    , "}"
    , "" ]
  IO.FS.createDirAll (".lake" / "build")
  IO.FS.writeFile sdkOut text
  IO.println s!"wrote harmonized SDK index ({sdkCollections.length} collections, {catalogVariantTypes.length} variant types, {workerRoutes.length} worker routes) to {sdkOut}"
