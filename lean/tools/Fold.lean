import Qpu

/-! # Fold

Lean writes the plan by which the site's icon folds. The digits of a hexbit stand in a ring, `Config.coinQubitSpace`
of them. One fold in half sends each place in the upper half of the places still spread to its mirror, `Fin.rev`,
and leaves the lower half; `Advantage.fold_upper_onto_lower` proves the mirror lies in the lower half, and
`Advantage.fold_unfold` that the same fold opens it again. The places still spread halve with each fold, so there are
`hexbit` folds, and the run stops unless every digit then lies on digit 0.

Run from the repository root: `lake env lean lean/tools/Fold.lean`.
The plan is written to `.lake/build/fold-index.ts`; `lake run index` installs it in the site's theme and
`lake run check` compares it. -/

open Lean Config

/-- One fold in half of a block of `2 * h` places: a place in the upper half goes to its mirror and is marked as
    moved; any other place stays. -/
def foldStep (h p : Nat) : Nat × Bool :=
  if hp : h ≤ p ∧ p < 2 * h then ((Fin.rev (⟨p, hp.2⟩ : Fin (2 * h))).val, true) else (p, false)

/-- The half of the places still spread at each fold: the ring halves `hexbit` times. -/
def halves : List Nat := (List.range hexbit).map fun k => coinQubitSpace / coins ^ (k + 1)

/-- The folds a digit takes part in, one mark for each fold, and the place it ends on. -/
def plan (i : Nat) : List Bool × Nat :=
  halves.foldl (fun (acc : List Bool × Nat) h => let step := foldStep h acc.2; (acc.1 ++ [step.2], step.1)) ([], i)

#eval show IO Unit from do
  let plans := (List.range coinQubitSpace).map plan
  if !plans.all (·.2 == 0) then throw (IO.userError "a digit does not end on digit 0")
  IO.FS.writeFile (".lake" / "build" / "fold-index.ts") <|
    "// GENERATED by lake run index from Advantage.fold_upper_onto_lower (lean/tools/Fold.lean). Do not edit: Lean is the author.\n" ++
    "export const FOLD = " ++ (Json.mkObj [("digits", toJson coinQubitSpace), ("halves", toJson halves), ("moves", toJson (plans.map (·.1)))]).compress ++ " as const\n"
  IO.println s!"fold-index.ts: {coinQubitSpace} digits, {halves.length} folds"
