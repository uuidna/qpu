import Lean
import Qpu

/-! # Textbook

Lean writes the textbook index: every theorem the author declared in `Qpu.General.Textbook` that is not marked as a
reflection, in the order of the source. Each row is the theorem's name, its text as the source states it, the
sentence and the examples of its inline doc (`<sentence> (examples: a, b)`), and the `example` lines that follow it.
Lean finds each theorem by the place it holds in the source; nothing reads the file by guessing at its lines.

Run from the repository root: `lake env lean lean/tools/Textbook.lean`.
The index is written to `.lake/build/textbook-index.ts`; `lake run index` installs it and `lake run check` compares it. -/

open Lean

/-- Where the rendered index is written. -/
def textbookOut : System.FilePath := ".lake" / "build" / "textbook-index.ts"

/-- The source of the textbook. -/
def textbookSource : System.FilePath := "lean/Qpu/General/Textbook.lean"

#eval show CoreM Unit from do
  let env ← getEnv
  let lines := (← IO.FS.readFile textbookSource).splitOn "\n" |>.toArray
  -- every declared theorem of the textbook with its place, in source order
  let mut placed : Array (Name × DeclarationRanges) := #[]
  for (name, module) in ← Qpu.declaredTheorems do
    if module == `Qpu.General.Textbook then
      if let some ranges ← findDeclarationRanges? name then placed := placed.push (name, ranges)
  let ordered := placed.qsort (fun a b => a.2.range.pos.line < b.2.range.pos.line)
  let mut rows : Array String := #[]
  for i in [0:ordered.size] do
    let (name, ranges) := ordered[i]!
    if Qpu.isReflection env name then continue
    -- the theorem as the source states it: from the line of its name to the end of the declaration
    let text := "\n".intercalate ((lines.extract (ranges.selectionRange.pos.line - 1) ranges.range.endPos.line).toList)
    -- the `example` lines between this theorem and the next declaration
    let next := if h : i + 1 < ordered.size then ordered[i + 1].2.range.pos.line - 1 else lines.size
    let examples := (lines.extract ranges.range.endPos.line next).toList.filter (·.startsWith "example ")
    let doc := ((← findDocString? env name).getD "").trimAscii.toString
    let (sentence, named) := match doc.splitOn " (examples: " with
      | [only] => (only, ([] : List String))
      | parts =>
        let last := parts.getLast!
        let inside := (last.splitOn ")").head!
        ((" (examples: ".intercalate parts.dropLast), if inside == "none yet" then [] else inside.splitOn ", ")
    let fields : List (String × Json) :=
      [("key", .str name.toString), ("lean", .str text), ("says", .str sentence), ("examples", .arr (named.map Json.str).toArray)]
      ++ (if examples.isEmpty then [] else [("example", .str ("\n".intercalate examples))])
    rows := rows.push ("  {" ++ ",".intercalate (fields.map fun (key, value) => s!"{(Json.str key).compress}:{value.compress}") ++ "},")
  let text := "\n".intercalate (
    [ "// GENERATED by lake run index from Qpu/General/Textbook.lean. Do not edit: the Lean file is the author."
    , "/** A textbook theorem: its name, its Lean text, the sentence and examples of its inline doc, and the examples that follow it. */"
    , "export type TextbookRow = { key: string; lean: string; says: string; examples: string[]; example?: string }"
    , "export const TEXTBOOK_INDEX: readonly TextbookRow[] = [" ]
    ++ rows.toList ++ [ "]", "" ])
  IO.FS.createDirAll (".lake" / "build")
  IO.FS.writeFile textbookOut text
  IO.println s!"wrote {rows.size} textbook theorem(s), {ordered.size - rows.size} reflection(s) beside them, to {textbookOut}"
