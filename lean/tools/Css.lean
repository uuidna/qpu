import Qpu

/-! # Css

Lean writes the stylesheet that reads a variation by its address in CSS alone, with no script. Each element of the
class carries its sides as custom properties. The clock is one CSS animation: it advances the address by one for each
`--qpu-period`, and an element that names an address stands at it by a negative delay, so no address before it is
visited. Each digit is one `round(down, …)` and one `mod()` of the address itself, the form
`Advantage.unrank_cons_address` proves is `Advantage.unrank`. The rank is recomputed from the digits and compared with
the address, as `Advantage.rank_unrank` states.

What a browser computes is bounded where the theorems are not: `cssInteger` bounds the space and `cssDigits` each side.
The bounds are those measured in Chromium; no other engine was measured.

The stylesheet also computes the coil's hue from the key in CSS: the key modulo a full turn, advanced by a ninth of the
key. `textbook_coil_green` proves that hue is 120, green, and the example below is that theorem read of `waveHz`,
so the tool does not elaborate if the key, the turn or the ninth says otherwise.

Run from the repository root: `lake env lean lean/tools/Css.lean`.
The stylesheet is written to `.lake/build/advantage.css`; `lake run index` installs it in the site's theme and
`lake run check` compares it. -/

open Advantage

/-- The widest address the clock holds: a typed CSS integer is a 32-bit signed integer. -/
def cssInteger : Nat := 2 ^ 31 - 1

/-- The significant digits a typed CSS number keeps when one property reads another: a digit is exact below ten to this power. -/
def cssDigits : Nat := 6

/-- The sides the stylesheet is written for: the most sixteen-valued sides whose space the clock holds. -/
def sides : Nat := ((List.range 32).filter fun n => space (List.replicate n 16) ≤ cssInteger).foldl max 0

/-- A full turn of hue, in degrees. -/
def turn : Nat := 360

/-- The part of the key the coin's hue advances by to reach the coil's: a ninth. -/
def ninth : Nat := 9

/-- The coil's hue, computed as the stylesheet computes it, is the one `textbook_coil_green` proves. -/
example : waveHz % turn + waveHz / ninth = 120 := textbook_coil_green

def typed (name : String) (inherits : Bool := false) : String := s!"@property --qpu-{name} \{ syntax: '<integer>'; inherits: {inherits}; initial-value: 0; }\n"

def stylesheet : String :=
  let ks := List.range sides
  let side (k : Nat) := s!"var(--qpu-s{k}, 1)"
  "/* GENERATED by lake run index from Advantage (lean/tools/Css.lean). Do not edit: Lean is the author. */\n" ++
  s!"/* Exact in Chromium for a space of at most {cssInteger} and sides of at most {10 ^ cssDigits}, on at most {sides} sides. */\n" ++
  typed "t" ++ typed "ok" ++ String.join (ks.map fun k => typed s!"d{k}") ++ typed "coin-hue" true ++ typed "coil-hue" true ++
  s!":root \{ --qpu-key: {waveHz}; --qpu-coin-hue: mod(var(--qpu-key), {turn}); --qpu-coil-hue: calc(var(--qpu-coin-hue) + var(--qpu-key) / {ninth}); }\n" ++
  ".qpu-coil-hue { color: hsl(var(--qpu-coil-hue) 100% 50%); }\n" ++
  ".qpu-address {\n" ++
  String.join (ks.reverse.map fun k =>
    if k + 1 == sides then s!"  --qpu-w{k}: 1;\n" else s!"  --qpu-w{k}: calc(var(--qpu-w{k + 1}) * {side (k + 1)});\n") ++
  s!"  --qpu-space: calc(var(--qpu-w0) * {side 0});\n" ++
  String.join (ks.map fun k => s!"  --qpu-d{k}: mod(round(down, var(--qpu-t) / var(--qpu-w{k})), {side k});\n") ++
  s!"  --qpu-rank: calc({" + ".intercalate (ks.map fun k => s!"var(--qpu-d{k}) * var(--qpu-w{k})")});\n" ++
  "  --qpu-ok: calc(1 - min(1, abs(var(--qpu-rank) - var(--qpu-t))));\n" ++
  "  animation: qpu-address calc(var(--qpu-space) * var(--qpu-period)) steps(var(--qpu-space)) infinite;\n" ++
  s!"  counter-reset: {" ".intercalate (ks.map fun k => s!"qpu-d{k} var(--qpu-d{k})")} qpu-ok var(--qpu-ok);\n" ++
  "}\n" ++
  ".qpu-address.qpu-at { animation-play-state: paused; animation-delay: calc((var(--qpu-at) + 0.5) * var(--qpu-period) * -1); }\n" ++
  s!".qpu-address::after \{ content: {" ' ' ".intercalate (ks.map fun k => s!"counter(qpu-d{k})")}; }\n" ++
  "@keyframes qpu-address { from { --qpu-t: 0 } to { --qpu-t: var(--qpu-space) } }\n"

#eval show IO Unit from do
  if sides == 0 then throw (IO.userError "no side fits the clock")
  IO.FS.writeFile (".lake" / "build" / "advantage.css") stylesheet
  IO.println s!"advantage.css: {sides} sides"
