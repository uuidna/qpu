import Lean
import Qpu.General.Thousand

/-! # Thousand

Lean writes the thousand-bit table: for each family formula, how many examples it has below `2 ^ 1000`, its first
examples, and its last example with that example's reflection at the bound; and the meaning of the numbers the table
itself holds, so each family sees which other families reach its values.

Run from the repository root: `lake env lean lean/tools/Thousand.lean`.
The index is written to `.lake/build/thousand-index.ts`; `lake run index` installs it and `lake run check` compares it. -/

open Lean Thousand

/-- Where the rendered index is written. -/
def thousandOut : System.FilePath := ".lake" / "build" / "thousand-index.ts"

#eval show IO Unit from do
  let mut rows : Array Json := #[]
  let mut shared : Array Json := #[]
  let mut seen : Array Nat := #[]
  for F in formulas do
    let count := examplesBelow F
    let firstSizes := (List.range 4).filter (· < count)
    let first := firstSizes.map fun k => Json.mkObj [("size", .str (toString k)), ("value", .str (toString (F.f k)))]
    let lastSize := count - 1
    let last := Json.mkObj [("size", .str (toString lastSize)), ("value", .str (toString (F.f lastSize))), ("reflection", .str (toString (reflect (F.f lastSize))))]
    rows := rows.push (Json.mkObj [("family", .str F.family), ("name", .str F.name), ("examples", .str (toString count)), ("first", .arr first.toArray), ("last", last)])
    -- the meaning of this formula's small values: the other families that reach the same number
    for k in firstSizes ++ (List.range 12).filter (fun k => k ≥ 4 && k < count) do
      let value := F.f k
      let found := meaning value
      if found.length ≥ 2 && !seen.contains value then
        seen := seen.push value
        shared := shared.push (Json.mkObj [("number", .str (toString value)), ("meaning", .arr (found.map fun (family, name, size) => Json.mkObj [("family", .str family), ("name", .str name), ("size", .str (toString size))]).toArray)])
  let text := "\n".intercalate (
    [ "// GENERATED by lake run index from Qpu.General.Thousand. Do not edit: Lean is the author."
    , "/** Each family formula below the thousand-bit bound: how many examples it has, its first, and its last with its reflection at 2 ^ 1000. */"
    , "export const THOUSAND: readonly { family: string; name: string; examples: string; first: readonly { size: string; value: string }[]; last: { size: string; value: string; reflection: string } }[] = [" ]
    ++ rows.toList.map (fun row => s!"  {row.compress},") ++
    [ "]"
    , "/** The numbers more than one family formula reaches, with their meaning: every formula that reaches the number and the size at which it does. */"
    , "export const THOUSAND_SHARED: readonly { number: string; meaning: readonly { family: string; name: string; size: string }[] }[] = [" ]
    ++ shared.toList.map (fun row => s!"  {row.compress},") ++ [ "]", "" ])
  IO.FS.createDirAll (".lake" / "build")
  IO.FS.writeFile thousandOut text
  IO.println s!"wrote {rows.size} family formula(s) and {shared.size} shared number(s) to {thousandOut}"
