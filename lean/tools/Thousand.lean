import Lean
import Qpu.General.Thousand
import Qpu.General.Meaning

/-! # Thousand

Lean writes the thousand-bit table: for each family formula, how many examples it has below `2 ^ 1000`, its first
examples, and its last example with that example's reflection at the bound; and the meaning of the numbers the table
itself holds, so each family sees which other families reach its values.

Lean also walks the register's qubits. `k` qubits hold a superposition of `2 ^ k` states, and the walk visits every `k`
whose superposition lies below the bound. At each one it finds the cluster: every family formula that reaches `2 ^ k`.
A formula with few examples below the bound is walked size by size; one with more examples than a search of every
level costs is asked at each level for the least size that reaches it (`Thousand.least`). Each formula is written with
the theorem of `Qpu.General.Meaning` that proves it equal, at every size, to the library notion it is, so each member
of a cluster names the theorem that holds it.

Run from the repository root: `lake env lean lean/tools/Thousand.lean`.
The index is written to `.lake/build/thousand-index.ts`; `lake run index` installs it and `lake run check` compares it. -/

open Lean Elab Command Thousand

/-- Where the rendered index is written. -/
def thousandOut : System.FilePath := ".lake" / "build" / "thousand-index.ts"

/-- The qubit counts at which a formula reaches the superposition `2 ^ k`, as one number: bit `k` is set for `k` qubits. -/
def levelsOf (F : Formula) (qubits : Nat) : Nat := Id.run do
  let count := examplesBelow F
  let mut mask := 0
  if count ≤ qubits * (2 * Nat.log2 count + 2) then
    -- fewer examples than a search of every level costs: every example is looked at
    for size in List.range count do
      let value := F.f size
      if value ≠ 0 && 2 ^ Nat.log2 value = value && mask / value % 2 = 0 then mask := mask + value
  else
    for k in List.range qubits do
      let value := 2 ^ k
      if F.f (least F.f value) = value then mask := mask + value
  return mask

run_cmd do
  let env ← getEnv
  let mut rows : Array Json := #[]
  let mut shared : Array Json := #[]
  let mut seen : Array Nat := #[]
  for F in formulas do
    let count := examplesBelow F
    let firstSizes := (List.range 4).filter (· < count)
    let first := firstSizes.map fun k => Json.mkObj [("size", .str (toString k)), ("value", .str (toString (F.f k)))]
    let lastSize := count - 1
    let last := Json.mkObj [("size", .str (toString lastSize)), ("value", .str (toString (F.f lastSize))), ("reflection", .str (toString (reflect (F.f lastSize))))]
    rows := rows.push (Json.mkObj [("family", .str F.family), ("name", .str F.name), ("examples", .str (toString count)), ("first", .arr first.toArray), ("last", last)])
    -- the meaning of this formula's small values: the other families that reach the same number
    for k in firstSizes ++ (List.range 12).filter (fun k => k ≥ 4 && k < count) do
      let value := F.f k
      let found := meaning value
      if found.length ≥ 2 && !seen.contains value then
        seen := seen.push value
        shared := shared.push (Json.mkObj [("number", .str (toString value)), ("meaning", .arr (found.map fun (family, name, size) => Json.mkObj [("family", .str family), ("name", .str name), ("size", .str (toString size))]).toArray)])
  -- the walk: every qubit count whose superposition lies below the bound, and the theorems that bind the formulas
  let qubits := least (fun k => 2 ^ k) bound
  let bindings := env.constants.toList.filterMap fun (n, _) =>
    let module := match env.getModuleIdxFor? n with
      | some i => env.header.modules[i.toNat]!.module
      | none => Name.anonymous
    if (`Qpu.General.Meaning).isPrefixOf module && (n.toString.splitOn "_eq_").length > 1 then some n.toString else none
  let mut walk : Array Json := #[]
  for F in formulas do
    let mask := levelsOf F qubits
    let reaches := (List.range qubits).filter (fun k => mask / 2 ^ k % 2 = 1) |>.length
    let binding := (bindings.filter (·.startsWith (F.name ++ "_eq_"))).toArray.qsort (· < ·) |>.toList.head?
    walk := walk.push (Json.mkObj [("family", .str F.family), ("name", .str F.name), ("binding", match binding with | some b => .str b | none => .null), ("reaches", toJson reaches), ("levels", .str (String.ofList (Nat.toDigits 16 mask)))])
  let text := "\n".intercalate (
    [ "// GENERATED by lake run index from Qpu.General.Thousand. Do not edit: Lean is the author."
    , "/** Each family formula below the thousand-bit bound: how many examples it has, its first, and its last with its reflection at 2 ^ 1000. */"
    , "export const THOUSAND: readonly { family: string; name: string; examples: string; first: readonly { size: string; value: string }[]; last: { size: string; value: string; reflection: string } }[] = [" ]
    ++ rows.toList.map (fun row => s!"  {row.compress},") ++
    [ "]"
    , "/** The numbers more than one family formula reaches, with their meaning: every formula that reaches the number and the size at which it does. */"
    , "export const THOUSAND_SHARED: readonly { number: string; meaning: readonly { family: string; name: string; size: string }[] }[] = [" ]
    ++ shared.toList.map (fun row => s!"  {row.compress},") ++
    [ "]"
    , "/** The walk of the register's qubits: every qubit count whose superposition 2 ^ k lies below the bound, and for each family formula the theorem that binds it to its library notion and the qubit counts at which it reaches that superposition (hex digits, bit k for k qubits). */"
    , s!"export const THOUSAND_WALK: \{ qubits: number; formulas: readonly \{ family: string; name: string; binding: string | null; reaches: number; levels: string }[] } = \{ qubits: {qubits}, formulas: [" ]
    ++ walk.toList.map (fun row => s!"  {row.compress},") ++ [ "] }", "" ])
  IO.FS.createDirAll (".lake" / "build")
  IO.FS.writeFile thousandOut text
  IO.println s!"wrote {rows.size} family formula(s), {shared.size} shared number(s) and the walk of {qubits} qubit count(s) to {thousandOut}"
