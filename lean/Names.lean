import Lean
import Qpu
import NamesBaseline

/-! # Names — one formula, one name

Built by default with the meaning gate, so `lake build`, and with it every commit, push and CI run, fails when a
theorem of the tree states a formula another theorem of the tree already states. Lean decides the sameness, not a
reading of the text: two statements are the same exactly when their types are equal kernel expressions up to the
names of their bound variables (`Expr.eqv`). Of two theorems with one formula, the first by name keeps it, and the
other is a second name for it.

The second names that stood when this check was made are listed in `NamesBaseline`, which this module writes when
`NAMES_RATCHET=1` is set. The check fails on a second name the list does not hold and on a listed one that no longer
stands, and against the list as committed (`NAMES_BASE` names the commit, `HEAD` by default) neither the ratchet nor a
hand adds one to it: the list only shrinks. -/

open Lean Elab Command

run_cmd do
  let env ← getEnv
  let declared ← liftCoreM Qpu.declaredTheorems
  let mut first : Std.HashMap Expr Name := {}
  let mut seconds : Array String := #[]
  for (name, _) in declared do
    let some info := env.find? name | continue
    match first.get? info.type with
    | some kept => seconds := seconds.push s!"{name} states the formula of {kept}"
    | none => first := first.insert info.type name
  let current := seconds.qsort (· < ·)
  let ref := (← IO.getEnv "NAMES_BASE").getD "HEAD"
  let committed ← match ← (IO.Process.output { cmd := "git", args := #["show", s!"{ref}:lean/NamesBaseline.lean"] }).toBaseIO with
    | .ok o => pure (if o.exitCode == 0 then some o.stdout else none)
    | .error _ => pure none
  let added := match committed with
    | some listed => current.filter (fun (v : String) => (listed.splitOn v.quote).length == 1)
    | none => #[]
  for v in added.toList.take 20 do IO.println s!"  would ENTER the list: {v}"
  unless added.isEmpty do
    throwError s!"Names: {added.size} second name(s) the committed list ({ref}) does not hold: the list only shrinks, so state each formula once"
  if (← IO.getEnv "NAMES_RATCHET").isSome then
    IO.FS.writeFile "lean/NamesBaseline.lean" <|
      "/-! # NamesBaseline\nGENERATED by `NAMES_RATCHET=1 lake env lean lean/Names.lean`, never edited by hand. Every theorem that " ++
      "states the\nformula of another theorem of the tree, named. The check fails on a second name not listed here and on " ++
      "a listed one\nthat no longer stands, so this list only shrinks. -/\n\n" ++
      s!"def namesBaseline : Array String := #[\n{",\n".intercalate (current.toList.map (fun v => "  " ++ v.quote))}\n]\n"
    IO.println s!"NamesBaseline written: {current.size} second name(s) listed"
  else
    let base : Std.HashSet String := namesBaseline.foldl (·.insert ·) {}
    let now : Std.HashSet String := current.foldl (·.insert ·) {}
    let entered := current.filter (!base.contains ·)
    let struck := namesBaseline.filter (!now.contains ·)
    for v in entered.toList.take 20 do IO.println s!"  NEW second name: {v}"
    for v in struck.toList.take 20 do IO.println s!"  no longer stands (strike it from NamesBaseline): {v}"
    unless entered.isEmpty && struck.isEmpty do
      throwError s!"Names: {entered.size} new second name(s), {struck.size} gone but still listed"
