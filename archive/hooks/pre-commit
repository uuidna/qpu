#!/bin/sh
# pre-commit — HARD. Types must compile; occupancy naming gate; the full gate is pre-push.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: HARD — npm run build"
npm run build
echo "pre-commit: HARD — occupancy fuse-gate"
node --test dist/fuse-gate.test.js
status=$?
if [ $status -ne 0 ]; then
  echo "pre-commit: RED — commit BLOCKED."
  exit $status
fi
exit 0
