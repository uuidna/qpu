  },
  "homepage": "https://qpu.uuidna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuidna/qpu.git"
  },
  "bugs": {
    "url": "https://github.com/uuidna/qpu/issues"
  },
  "keywords": [
    "qpu",
    "quantum-processing-unit",
    "uuidna",
    "mcp"
  ],
  "main": "./dist/quantum/processing/unit/index.js",
  "types": "./qpu.d.ts",
  "exports": {
    ".": {
      "types": "./qpu.d.ts",
      "import": "./dist/quantum/processing/unit/index.js",
      "default": "./dist/quantum/processing/unit/index.js"
    },
    "./boot": {
      "types": "./dist/quantum/processing/unit/boot.d.ts",
      "import": "./dist/quantum/processing/unit/boot.js",
      "default": "./dist/quantum/processing/unit/boot.js"
    },
    "./payload": {
      "types": "./dist/db/payload-qpu.d.ts",
      "import": "./dist/db/payload-qpu.js",
      "default": "./dist/db/payload-qpu.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
