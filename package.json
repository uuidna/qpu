{
  "name": "qpu",
  "version": "1.0.0",
  "description": "qpu.uuidna.com: the quantum MCP catalogue at /api/mcp beside its Lean-written VitePress site, on a Cloudflare Worker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "wrangler dev --port 3000",
    "deploy": "lake run site && wrangler deploy",
    "lean:check": "lake run check",
    "lean:index": "lake run index",
    "site:seed": "lake run seed",
    "site:build": "lake run site",
    "site:dev": "lake run seed && vitepress dev site",
    "test": "node --test \"src/quantum/**/*_test.ts\" \"src/quantum/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@uuidna/qpu": "link:src/quantum"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "eslint": "^9.16.0",
    "typescript": "6.0.3",
    "vitepress": "2.0.0-alpha.21",
    "wrangler": "~4.116.0"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "private": true
}
