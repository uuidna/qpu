{
  "name": "qpu",
  "version": "1.1.1",
  "description": "qpu.uuidna.com: the quantum MCP catalogue at /api/mcp beside its Lean-written VitePress site, on a Cloudflare Worker",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "wrangler dev --port 3000",
    "deploy": "node src/quantum/processing/machine-run.ts fakes && lake run site && wrangler deploy",
    "lean:check": "lake run check",
    "lean:index": "lake run index",
    "site:seed": "lake run seed",
    "site:build": "lake run site",
    "site:dev": "lake run seed && vitepress dev site",
    "test": "node --test \"src/quantum/**/*_test.ts\" \"src/quantum/**/*.test.ts\"",
    "typecheck": "wrangler types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@uuidna/qpu": "link:src/quantum",
    "@x402/core": "2.32.0",
    "@x402/evm": "2.32.0",
    "agents": "0.34.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "eslint": "^9.16.0",
    "typescript": "6.0.3",
    "vitepress": "2.0.0-alpha.21",
    "wrangler": "~4.116.0"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "private": true
}
