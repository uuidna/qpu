{
  "name": "@uuidna/qpu",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Running quantum circuit at https://qpu.uuidna.com. theorem quantum. Public quantum API. Reads need no auth; storage writes need a Bearer token. JSON-LD. The TypeScript and Lean sources are the blueprint.",
  "type": "module",
  "license": "CC-BY-NC-ND-4.0",
  "funding": {
    "type": "individual",
    "url": "https://revolut.me/ceccec"
  },
  "author": {
    "name": "Tsvetan Rouschev",
    "email": "ceccec@psg.bg",
    "url": "https://orcid.org/0009-0000-7312-9778"
  },
  "homepage": "https://qpu.uuidna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuidna/qpu.git"
  },
  "bugs": {
    "url": "https://github.com/uuidna/qpu/issues"
  },
  "keywords": [
    "qpu",
    "quantum-processing-unit",
    "uuidna",
    "mcp"
  ],
  "main": "./dist/quantum/processing/unit/index.js",
  "types": "./qpu.d.ts",
  "exports": {
    ".": {
      "types": "./qpu.d.ts",
      "import": "./dist/quantum/processing/unit/index.js",
      "default": "./dist/quantum/processing/unit/index.js"
    },
    "./boot": {
      "types": "./dist/quantum/processing/unit/boot.d.ts",
      "import": "./dist/quantum/processing/unit/boot.js",
      "default": "./dist/quantum/processing/unit/boot.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "qpu.d.ts",
    "src/quantum/processing/unit/index.lean",
    "LICENSE",
    "README.md",
    "CITATION.cff",
    "mcp.json",
    "install.json",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.d.ts",
    "dist/quantum/processing/unit/boot.d.ts",
    "!dist/**/readme.js",
    "!dist/**/readme.d.ts",
    "!dist/**/receipt.js",
    "!dist/**/receipt.d.ts",
    "!dist/**/receipted.js",
    "!dist/**/receipted.d.ts",
    "!dist/test/**"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "node scripts/version-lock.mjs && rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=./dist/quantum/processing/unit/receipt.js --test-reporter-destination=stdout dist/quantum/processing/unit/*.test.js",
    "ci": "npm run build && npm test && npm run readme",
    "readme": "node scripts/generate-readme.mjs",
    "prepublishOnly": "npm run version:lock && npm run build",
    "ship": "npm run build && npx wrangler deploy",
    "lean": "lean src/quantum/processing/unit/index.lean",
    "lean:embed": "node scripts/embed-lean.mjs",
    "version:lock": "node scripts/version-lock.mjs",
    "version": "npm run version:lock && npm run lean:embed && git add src/quantum/processing/unit/version.ts",
    "mcp": "npm run build && node dist/mcp/core.js",
    "version:auto": "npm run build && node -e \"import('./dist/mcp/version.js').then(m => m.autoVersion()).then(r => console.log(JSON.stringify(r, null, 2)))\"",
    "version:status": "npm run build && node -e \"import('./dist/mcp/version.js').then(m => m.statusVersion())\"",
    "status": "npm run mcp -- status",
    "health": "npm run mcp -- health",
    "uuid": "npm run mcp -- uuid",
    "ops": "npm run mcp -- ops",
    "obs": "npm run mcp -- obs",
    "gaps:fill": "npm run mcp -- gaps",
    "gaps:status": "npm run mcp -- status",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t uuidna-qpu:latest .",
    "docker:run": "docker-compose -f deploy/docker/docker-compose.yml up -d",
    "docker:stop": "docker-compose -f deploy/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f deploy/docker/docker-compose.yml logs -f qpu",
    "k8s:status": "kubectl rollout status deployment/qpu -n quantum",
    "k8s:scale": "kubectl scale deployment qpu -n quantum --replicas",
    "k8s:logs": "kubectl logs -n quantum -l app=uuidna-qpu -f",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:tail": "wrangler tail",
    "cf:kv:list": "wrangler kv:key list STORAGE",
    "cf:kv:get": "wrangler kv:key get STORAGE",
    "cf:kv:put": "wrangler kv:key put STORAGE",
    "cf:rollback": "wrangler rollback",
    "cf:verify": "curl https://qpu.uuidna.com/health && echo 'OK'",
    "install": "bash deploy/install.sh"
  },
  "devDependencies": {
    "@faceless-ui/modal": "3.0.1",
    "@faceless-ui/scroll-info": "2.0.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@payloadcms/db-d1-sqlite": "4.0.0-canary.37",
    "@payloadcms/db-mongodb": "4.0.0-canary.37",
    "@payloadcms/email-resend": "4.0.0-canary.37",
    "@payloadcms/graphql": "4.0.0-canary.37",
    "@payloadcms/next": "4.0.0-canary.37",
    "@payloadcms/plugin-cloud-storage": "4.0.0-canary.37",
    "@payloadcms/plugin-ecommerce": "4.0.0-canary.37",
    "@payloadcms/plugin-form-builder": "4.0.0-canary.37",
    "@payloadcms/plugin-import-export": "4.0.0-canary.37",
    "@payloadcms/plugin-mcp": "4.0.0-canary.37",
    "@payloadcms/plugin-multi-tenant": "4.0.0-canary.37",
    "@payloadcms/plugin-nested-docs": "4.0.0-canary.37",
    "@payloadcms/plugin-redirects": "4.0.0-canary.37",
    "@payloadcms/plugin-search": "4.0.0-canary.37",
    "@payloadcms/plugin-sentry": "4.0.0-canary.37",
    "@payloadcms/plugin-seo": "4.0.0-canary.37",
    "@payloadcms/plugin-stripe": "4.0.0-canary.37",
    "@payloadcms/richtext-lexical": "4.0.0-canary.37",
    "@payloadcms/sdk": "4.0.0-canary.37",
    "@payloadcms/storage-r2": "4.0.0-canary.37",
    "@payloadcms/storage-s3": "4.0.0-canary.37",
    "@payloadcms/translations": "4.0.0-canary.37",
    "@payloadcms/ui": "4.0.0-canary.37",
    "@types/express": "5.0.6",
    "@types/node": "26.6.0",
    "graphql": "16.14.2",
    "next": "16.3.7",
    "payload": "4.0.0-canary.37",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "wrangler": "4.143.1"
  },
  "bin": {
    "qpu-boot": "./dist/quantum/processing/unit/boot.js"
  },
  "dependencies": {
    "@types/react": "19.3.0",
    "lucide-react": "1.49.0",
    "recharts": "3.10.1",
    "uuid": "14.0.2"
  }
}
