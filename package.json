  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "node scripts/version-lock.mjs && rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=./dist/quantum/processing/unit/receipt.js --test-reporter-destination=stdout dist/quantum/processing/unit/*.test.js dist/families/*/test.js",
    "test:scripts": "node --test scripts/*.test.mjs",
    "ci": "npm run build && npm test && npm run test:scripts && npm run readme",
    "readme": "node scripts/generate-readme.mjs",
    "receipt": "node scripts/receipt.mjs",
    "discover": "node scripts/discover.mjs",
    "docs": "node scripts/generate-docs.mjs",
    "fuse": "node scripts/fuse-apis.mjs",
    "payload:cf": "node scripts/payload-cloudflare.mjs",
    "heat": "node scripts/heat.mjs",
    "hooks": "node dist/deployment/git-hooks.js install",
    "prepublishOnly": "npm run version:lock && npm run build",
    "ship": "npm run build && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lean": "lake build && node scripts/lean-bundle.mjs --check && lean src/quantum/processing/unit/index.lean",
    "lean:bundle": "node scripts/lean-bundle.mjs",
    "lean:embed": "node scripts/lean-bundle.mjs && node scripts/embed-lean.mjs",
    "version:lock": "node scripts/version-lock.mjs",
    "version": "npm run version:lock && npm run lean:embed && git add src/quantum/processing/unit/version.ts",
    "mcp": "npm run build && node dist/mcp/core.js",
    "mcp:server": "npm run build && node dist/mcp/mcp-server.js",
    "version:auto": "npm run build && node -e \"import('./dist/mcp/version.js').then(m => m.autoVersion()).then(r => console.log(JSON.stringify(r, null, 2)))\"",
    "version:status": "npm run build && node -e \"import('./dist/mcp/version.js').then(m => m.statusVersion())\"",
    "status": "npm run mcp -- status",
    "health": "npm run mcp -- health",
    "uuid": "npm run mcp -- uuid",
    "ops": "npm run mcp -- ops",
    "obs": "npm run mcp -- obs",
    "gaps:fill": "npm run mcp -- gaps",
    "gaps:status": "npm run mcp -- status",
    "formulas:seal": "npm run build && node scripts/formulas-as-leads.mjs",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t uuidna-qpu:latest .",
    "docker:run": "docker-compose -f deploy/docker/docker-compose.yml up -d",
    "docker:stop": "docker-compose -f deploy/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f deploy/docker/docker-compose.yml logs -f qpu",
    "k8s:status": "kubectl rollout status deployment/qpu -n quantum",
    "k8s:scale": "kubectl scale deployment qpu -n quantum --replicas",
    "k8s:logs": "kubectl logs -n quantum -l app=uuidna-qpu -f",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:tail": "wrangler tail",
    "cf:kv:list": "wrangler kv:key list STORAGE",
    "cf:kv:get": "wrangler kv:key get STORAGE",
    "cf:kv:put": "wrangler kv:key put STORAGE",
    "cf:rollback": "wrangler rollback",
    "cf:verify": "curl https://qpu.uuidna.com/health && echo 'OK'",
    "deploy:install": "bash deploy/install.sh"
  },
