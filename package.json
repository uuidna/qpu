{
  "name": "@uuidna/qpu",
  "version": "0.3.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "QPU worker at https://qpu.uuidna.com — quantum processing unit.",
  "type": "module",
  "license": "CC-BY-NC-ND-4.0",
  "funding": {
    "type": "individual",
    "url": "https://revolut.me/ceccec"
  },
  "author": {
    "name": "Tsvetan Rouschev",
    "email": "ceccec@psg.bg",
    "url": "https://revolut.me/ceccec"
  },
  "homepage": "https://qpu.uuidna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuidna/qpu.git"
  },
  "bugs": {
    "url": "https://github.com/uuidna/qpu/issues"
  },
  "keywords": [
    "qpu",
    "quantum-processing-unit",
    "uuidna"
  ],
  "main": "./dist/quantum/processing/unit/index.js",
  "types": "./dist/quantum/processing/unit/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/quantum/processing/unit/index.d.ts",
      "import": "./dist/quantum/processing/unit/index.js"
    },
    "./quantum/processing/unit": {
      "types": "./dist/quantum/processing/unit/index.d.ts",
      "import": "./dist/quantum/processing/unit/index.js"
    }
  },
  "files": [
    "dist",
    "worker.js",
    "wrangler.toml",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/quantum/processing/unit/*.test.js",
    "ci": "npm test",
    "ship": "npm run build && npx wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "7.0.2",
    "vitepress": "2.0.0-alpha.20",
    "wrangler": "4.130.0"
  }
