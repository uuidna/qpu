{
  "name": "@uuidna/qpu",
  "version": "1.4.0",
  "type": "module",
  "exports": {
    ".": "./src/quantum/processing/unit/index.ts",
    "./mcp": "./src/quantum/processing/mcp.ts",
    "./discovery-document": "./src/quantum/processing/discovery-document.ts",
    "./version": "./src/quantum/processing/unit/version.ts",
    "./blocks": "./src/quantum/processing/unit/blocks.ts",
    "./roles": "./src/quantum/processing/unit/roles.ts",
    "./machine": "./scripts/machine.ts",
    "./payload": "./src/quantum/processing/toolboxes/payload.ts"
  },
  "files": [
    "src/quantum",
    "scripts/machine.ts",
    "!src/quantum/**/*.test.ts"
  ],
  "license": "CC-BY-NC-ND-4.0",
  "author": {
    "name": "Tsvetan Rouschev",
    "url": "https://orcid.org/0009-0000-7312-9778"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'src/quantum/**/*.test.ts'",
    "docs:gen": "node scripts/gen-docs.ts",
    "docs:dev": "npm run docs:gen && vitepress dev docs",
    "docs:build": "npm run docs:gen && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "audit": "node scripts/audit.ts",
    "mcp:crypto": "node --import tsx src/mcp/crypto/index.ts",
    "test:e2e": "node scripts/e2e.ts",
    "next": "node scripts/next.ts",
    "precheck": "node scripts/hook.ts pre-deploy",
    "verify": "node scripts/verify.ts",
    "lean": "lake build",
    "next:watch": "node --watch-path=src --watch-path=scripts --watch-path=docs/index.md scripts/next.ts --offline",
    "purify": "node scripts/purify.ts",
    "readiness": "node scripts/readiness.ts",
    "imagine": "node scripts/imagine.ts",
    "dev:worker": "wrangler dev",
    "deploy": "npm run next -- --offline --fast && vitepress build docs && wrangler deploy",
    "publish": "node scripts/publish.ts",
    "clay:gen": "node scripts/gen-clay.ts",
    "pretest": "node scripts/gen-clay.ts && node scripts/gen-docs.ts",
    "next:fast": "node scripts/next.ts --offline --fast",
    "next:chain": "QPU_NEXT_CHAIN=1 node scripts/next.ts",
    "leads": "node scripts/mcp.ts leads-sync",
    "clean": "node scripts/mcp.ts leads-sync && node scripts/mcp.ts tables-sync"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.22.4",
    "typescript": "7.0.2",
    "vitepress": "2.0.0-alpha.21",
    "wrangler": "^4.152.0"
  },
  "description": "The Google Quantum AI layer: the Willow processor as its spec sheet states it, Cirq gates and circuits, Quantum Echoes with the benchmark Google states, and one MCP surface that compiles them on request.",
  "homepage": "https://github.com/uuidna/qpu",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
