{
  "name": "@uuidna/qpu",
  "version": "0.1.9",
  "publishConfig": {
    "access": "public"
  },
  "description": "Running quantum circuit at https://qpu.uuidna.com. theorem quantum. Public quantum API. Reads need no auth; storage writes need a Bearer token. JSON-LD. The TypeScript and Lean sources are the blueprint.",
  "type": "module",
  "license": "CC-BY-NC-ND-4.0",
  "funding": {
    "type": "individual",
    "url": "https://revolut.me/ceccec"
  },
  "author": {
    "name": "Tsvetan Rouschev",
    "email": "ceccec@psg.bg",
    "url": "https://orcid.org/0009-0000-7312-9778"
  },
  "homepage": "https://qpu.uuidna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuidna/qpu.git"
  },
  "bugs": {
    "url": "https://github.com/uuidna/qpu/issues"
  },
  "keywords": [
    "qpu",
    "quantum-processing-unit",
    "uuidna",
    "mcp"
  ],
  "main": "./server.js",
  "types": "./qpu.d.ts",
  "exports": {
    ".": {
      "types": "./qpu.d.ts",
      "import": "./dist/quantum/processing/unit/index.js",
      "default": "./dist/quantum/processing/unit/index.js"
    },
    "./boot": {
      "types": "./dist/quantum/processing/unit/boot.d.ts",
      "import": "./dist/quantum/processing/unit/boot.js",
      "default": "./dist/quantum/processing/unit/boot.js"
    },
    "./server": {
      "import": "./server.js",
      "default": "./server.js"
    }
  },
  "files": [
    "dist",
    "qpu.d.ts",
    "src/quantum/processing/unit/index.lean",
    "LICENSE",
    "README.md",
    "CITATION.cff",
    "mcp.json",
    "install.json",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.d.ts",
    "!dist/**/readme.js",
    "!dist/**/readme.d.ts",
    "!dist/**/receipt.js",
    "!dist/**/receipt.d.ts",
    "!dist/**/receipted.js",
    "!dist/**/receipted.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "lean": "lean src/quantum/processing/unit/index.lean",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=./dist/quantum/processing/unit/receipt.js --test-reporter-destination=stdout dist/quantum/processing/unit/*.test.js",
    "test:coverage": "node test-coverage.config.mjs",
    "ci": "npm run lean && npm test && npm run proof && npm run mutate && npm run test:scripts && npm run walls",
    "prepublishOnly": "npm run build",
    "ship": "npm run build && npx wrangler deploy",
    "test:rollcall": "npm run build && node --test dist/quantum/processing/unit/*.test.js",
    "payload:validate": "node scripts/payload-validate.mjs",
    "payload:seed": "node scripts/payload-seed.mjs",
    "payload:admin": "payload dev",
    "lean:embed": "node scripts/embed-lean.mjs",
    "verify:live": "node scripts/verify-live.mjs https://qpu.uuidna.com",
    "test:live": "QPU_LIVE=https://qpu.uuidna.com node --test --test-reporter=spec dist/quantum/processing/unit/live.test.js",
    "proof": "git diff --exit-code -- test-receipt.json",
    "examine": "node scripts/examine.mjs https://qpu.uuidna.com",
    "verify:release": "node scripts/verify-release.mjs",
    "debts": "node scripts/debts.mjs",
    "lattice": "node scripts/lattice.mjs",
    "lattice:fix": "node scripts/lattice.mjs --fix",
    "leads": "node scripts/leads.mjs",
    "refusals": "node scripts/refusals.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "walls": "node scripts/walls.mjs",
    "leads:test": "node --test scripts/leads.test.mjs",
    "outage": "node scripts/outage.mjs",
    "percall": "node scripts/percall.mjs",
    "costs": "node scripts/monitor-costs.mjs",
    "outage:test": "node --test scripts/outage.test.mjs",
    "post-push": "node scripts/post-push.mjs",
    "land": "npm test && git push && node scripts/post-push.mjs --wait && npm run verify:live",
    "mutate": "node scripts/mutate.mjs",
    "server": "NODE_ENV=production node server.js",
    "dev": "NODE_ENV=development node server.js",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t uuidna-qpu:latest .",
    "docker:run": "docker-compose -f deploy/docker/docker-compose.yml up -d",
    "docker:stop": "docker-compose -f deploy/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f deploy/docker/docker-compose.yml logs -f qpu",
    "k8s:deploy": "kubectl apply -f deploy/kubernetes/",
    "k8s:status": "kubectl rollout status deployment/qpu -n quantum",
    "k8s:scale": "kubectl scale deployment qpu -n quantum --replicas",
    "k8s:logs": "kubectl logs -n quantum -l app=uuidna-qpu -f",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:tail": "wrangler tail",
    "cf:kv:list": "wrangler kv:key list STORAGE",
    "cf:kv:get": "wrangler kv:key get STORAGE",
    "cf:kv:put": "wrangler kv:key put STORAGE",
    "cf:rollback": "wrangler rollback",
    "cf:verify": "curl https://qpu.uuidna.com/health && echo 'OK'",
    "install": "bash deploy/install.sh"
  },
  "devDependencies": {
    "@types/node": "26.6.0",
    "typescript": "7.0.2",
    "wrangler": "4.132.0"
  },
  "bin": {
    "qpu-boot": "./dist/quantum/processing/unit/boot.js"
  },
  "dependencies": {
    "uuid": "14.0.2"
  }
}
