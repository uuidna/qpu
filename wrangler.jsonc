{
  // The QPU Worker: the pure handler over HTTP at /mcp, the discovery document, and the Durable Object docket, one per tenant.
  // One Worker serves qpu.ceci.workers.dev and the custom domains of both tenants; tokens are wrangler secrets, per tenant
  // (QPU_WRITE_TOKEN_UUIDNA, QPU_WRITE_TOKEN_PSG, QPU_ADMIN_TOKEN_*) or shared (QPU_WRITE_TOKEN, QPU_ADMIN_TOKEN), never committed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qpu",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // the built site served by the same Worker: the web OS installable at every tenant; the Worker runs first so /mcp, /docket and /.well-known stay its own
  "assets": { "directory": "./docs/.vitepress/dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "routes": [
    { "pattern": "qpu.uuidna.com", "custom_domain": true },
    { "pattern": "qpu.psg.bg", "custom_domain": true }
  ],
  "durable_objects": { "bindings": [{ "name": "DOCKET", "class_name": "DocketObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocketObject"] }],
  "observability": { "enabled": true }
}
