// GENERATED by npm run next through configure { kind: 'wrangler' } on every run; edit src/quantum/processing/toolboxes/payload.ts (the tenants, the toolboxes' needs), never this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qpu",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "webcrypto_modern_algorithms"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./docs/.vitepress/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "qpu.uuidna.com",
      "custom_domain": true
    },
    {
      "pattern": "qpu.psg.bg",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCKET",
        "class_name": "DocketObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DocketObject"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "a432": {
      "name": "qpu-a432",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "QPU_USE_CASE": "a432",
        "QPU_PRODUCT": "qpu-a432",
        "QPU_UNIT": "none",
        "QPU_LICENCE": "a432: free under attribution"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DOCKET",
            "class_name": "DocketObject"
          }
        ]
      }
    },
    "domain": {
      "name": "qpu-domain",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "QPU_USE_CASE": "domain",
        "QPU_PRODUCT": "qpu-domain",
        "QPU_UNIT": "domain",
        "QPU_LICENCE": "covered by the licence (yearly, monthly)"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DOCKET",
            "class_name": "DocketObject"
          }
        ]
      }
    },
    "tenant": {
