// GENERATED by npm run next through configure { kind: 'wrangler' } on every run; edit src/quantum/toolboxes/payload.ts (the tenants, the toolboxes' needs), never this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qpu",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "webcrypto_modern_algorithms"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./docs/.vitepress/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "qpu.uuidna.com",
      "custom_domain": true
    },
    {
      "pattern": "qpu.psg.bg",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCKET",
        "class_name": "DocketObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DocketObject"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
