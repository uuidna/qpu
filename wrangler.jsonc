{
  // The QPU Worker: the pure handler over HTTP at /mcp, the discovery document, and the Durable Object docket.
  // Deploy is the author's act (`npm run deploy`); nothing here deploys on its own. QPU_WRITE_TOKEN is a wrangler secret.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uuidna-qpu",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "qpu.uuidna.com", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "DOCKET", "class_name": "DocketObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocketObject"] }],
  "observability": { "enabled": true }
}
