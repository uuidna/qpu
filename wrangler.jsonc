{
  "$schema": "node_modules/wrangler/config-schema.json",
  // /api/mcp through serveMcp; every other path is the VitePress site that `lake run site` builds
  "main": "src/quantum/net/worker.ts",
  "name": "qpu",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // qpu.uuidna.com and qpu.psg.bg, as the live qpu Worker serves them
  "routes": [
    { "pattern": "qpu.uuidna.com", "custom_domain": true },
    { "pattern": "qpu.psg.bg", "custom_domain": true },
  ],
  "assets": {
    "directory": "site/.vitepress/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/mcp"],
  },
  // The live qpu Worker holds these Durable Object migration tags (v2 deleted its only class); a deploy under the
  // same name repeats them.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DocketObject"] },
    { "tag": "v2", "deleted_classes": ["DocketObject"] },
    { "tag": "v3", "new_sqlite_classes": ["Mailbox"] },
    { "tag": "v4", "new_sqlite_classes": ["Prover"] },
  ],
  // Lean with Mathlib behind the Worker: the prover stage of the Alpine image (Lean built from source, Mathlib's cache),
  // started by the Prover Durable Object with no internet. Mathlib loaded is some 3 GiB a check, the image some 10 GB.
  // Local development runs the Worker without the prover: its image builds Lean from source and fetches Mathlib, hours of
  // work, and src/quantum/net/prover_test.ts checks the prover's server against this checkout's own Lean instead.
  "dev": { "enable_containers": false },
  "containers": [
    { "class_name": "Prover", "image": "./alpine/Dockerfile", "image_build_context": ".", "instance_type": "standard-4", "max_instances": 2 },
  ],
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }, { "name": "PROVER", "class_name": "Prover" }],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
