{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/quantum/processor.ts",
    "src/quantum/processor.test.ts",
    "src/quantum/cirq.ts",
    "src/quantum/cirq.test.ts",
    "src/quantum/echo.ts",
    "src/quantum/echo.test.ts"
  ]
}
