# Real-World Autonomous Execution Configuration
# Copy this file to .env and fill in actual credentials to enable real prize submissions

# ==============================================================================
# BOUNTIES.NETWORK
# ==============================================================================
# Get API Key: https://bounties.network/settings/api
# 1. Log in to bounties.network
# 2. Go to Settings → API
# 3. Create new API key
# 4. Copy the Bearer token
BOUNTIES_API_KEY=your_bounties_api_key_here

# Your Ethereum wallet address for prize payouts
BOUNTIES_WALLET=0x...

# ==============================================================================
# KAGGLE
# ==============================================================================
# Get Credentials: https://www.kaggle.com/settings/account
# 1. Log in to Kaggle
# 2. Go to Settings → Account
# 3. Click "Create New API Token"
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_API_KEY=your_kaggle_api_key_here

# ==============================================================================
# HACKERONE
# ==============================================================================
# Get API Key: https://hackerone.com/settings/api-keys
HACKERONE_API_KEY=your_hackerone_api_key_here
HACKERONE_PROGRAM=your_program_slug_here

# ==============================================================================
# INNOCENTIVE
# ==============================================================================
# Get API Key: https://www.innocentive.com/api
INNOCENTIVE_API_KEY=your_innocentive_api_key_here
INNOCENTIVE_EMAIL=your_email@example.com

# ==============================================================================
# EXECUTION CONFIGURATION
# ==============================================================================
# Dry run mode: test without actual submissions
DRY_RUN=true

# Maximum problems to solve per execution
MAX_PROBLEMS=1

# Minimum prize value to attempt
MIN_PRIZE=25000

# Auto-payout on verification
AUTO_PAYOUT=false
