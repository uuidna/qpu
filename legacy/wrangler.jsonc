{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qpu",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "qpu.uuidna.com", "custom_domain": true },
    { "pattern": "qpu.psg.bg", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "qpu",
      "database_id": "126117f2-95b6-4d63-a3c3-65556ebbfc7a",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "qpu-media"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DocketObject"] },
    { "tag": "v2", "deleted_classes": ["DocketObject"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
