// GENERATED by npm run next through configure { kind: 'adapters' } on every run; edit src/quantum/toolboxes/payload.ts (the tenants, the toolboxes' needs), never this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qpu-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "webcrypto_modern_algorithms"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "QPU_ADAPTERS": "cloudflare",
    "QPU_ORIGIN": "https://qpu.uuidna.com"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "qpu-site",
      "database_id": "<the tenant's>"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "qpu-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<the tenant's>"
    }
  ],
  "services": [
    {
      "binding": "QPU",
      "service": "qpu"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
