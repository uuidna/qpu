# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/archive/*
!/archive/.gitkeep

/src/docs
/preview-runtimes/v4/src/generated
/public/docs/v3
/public/docs/v4

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# OpenNext / Cloudflare
.open-next/

# content-addressed raid
/.qpu/
.wrangler/
.dev.vars

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env
# Sentry Config File
.sentryclirc

/.idea/*
!/.idea/runConfigurations
!/.idea/payload.iml

/db/*

# Payload ecommerce template (create-payload-app 4.0.0-beta.7)
.playwright
playwright-report/
playwright-report/index.html
.env*
!.env.example
public/media
/legacy/.next/
.lake/
# the VitePress site is rendered from the seeds and from Lean (lake run seed); only its config and the routes of its catalog are kept
site/*
!site/.vitepress/
site/.vitepress/*
!site/.vitepress/config.ts
!site/.vitepress/catalog-routes.ts
!site/.vitepress/theme/
!site/.vitepress/theme/**

# Payload migration schema snapshots are derived dev artifacts (used only by `payload migrate:create`,
# never at runtime); only the .ts up/down pairs are tracked and run.
src/migrations/*.json

# generated by `wrangler types` (npm run typecheck)
worker-configuration.d.ts
