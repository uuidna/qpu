{
  "id": "qkd-toolset",
  "name": "Quantum Key Distribution (QKD)",
  "description": "Establish theoretically unbreakable cryptographic keys using quantum entanglement",
  "category": "usecase",
  "tools": [
    {
      "name": "qkd-prepare-keys",
      "description": "Prepare quantum key using Bell states",
      "command": "qpu examples run qiskit-bell-state --shots 1000",
      "inputs": {
        "exampleId": "qiskit-bell-state",
        "provider": "ibm-quantum",
        "shots": "1000"
      },
      "outputs": [
        "receipt",
        "fidelity",
        "nativeComputation",
        "hardwareMetrics"
      ]
    },
    {
      "name": "qkd-measure-eavesdrop",
      "description": "Detect eavesdropping via entanglement breaking",
      "command": "qpu examples native-proof qiskit-bell-state",
      "inputs": {
        "exampleId": "qiskit-bell-state",
        "provider": "ibm-quantum",
        "shots": "1000"
      },
      "outputs": [
        "receipt",
        "fidelity",
        "nativeComputation",
        "hardwareMetrics"
      ]
    },
    {
      "name": "qkd-compare-providers",
      "description": "Compare QKD security across providers",
      "command": "qpu examples compare qiskit-bell-state --providers ibm-quantum,google-cirq",
      "inputs": {
        "exampleId": "qiskit-bell-state",
        "provider": "ibm-quantum",
        "shots": "1000"
      },
      "outputs": [
        "receipt",
        "fidelity",
        "nativeComputation",
        "hardwareMetrics"
      ]
    }
  ]
}