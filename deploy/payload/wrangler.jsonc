{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uuidna-qpu-payload",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "STORAGE"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "uuidna-qpu-payload-blobs"
    }
  ]
}
