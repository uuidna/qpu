#!/bin/sh
# pre-commit — HARD. Lean proof of the QPU.
set -e
cd "$(git rev-parse --show-toplevel)"
src="src/quantum/processing/unit/index.lean"
echo "pre-commit: HARD — lean $src"
command -v lean >/dev/null || { echo "pre-commit: RED — lean missing. Commit BLOCKED."; exit 1; }
lean "$src"
# heat: the hottest files, the staged ones first; a report, never a block
node scripts/heat.mjs --report 2>/dev/null || true
# the gate is a formula: gate.commit(i) for every staged family, through the MCP in-process — crossed with the public
# record (the APIs its formulas name read live, discovery with the readings) and within the rules; holds decides
node scripts/gate.mjs commit
git add gate-receipt.json
