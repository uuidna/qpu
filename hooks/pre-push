#!/bin/sh
# pre-push — HARD. Same door as GitHub CI.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: HARD — npm run ci"
node scripts/heat.mjs --report 2>/dev/null || true
# the gate is a formula: gate.push over every family, the proof and the rules; holds decides
node scripts/receipt.mjs gate push
npm run ci
status=$?
if [ $status -ne 0 ]; then
  echo "pre-push: RED — push BLOCKED."
  exit $status
fi
exit 0
