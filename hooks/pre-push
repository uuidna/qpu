#!/bin/sh
# pre-push — HARD. Same door as GitHub CI, deploy, and release. No push unless all green.
set -e
cd "$(git rev-parse --show-toplevel)"
if [ ! -f package.json ]; then
  echo "pre-push: HARD — package.json missing. Push BLOCKED."
  exit 1
fi
echo "pre-push: HARD — npm run ci (audit · tests · derived paper · docs · wrangler dry-run)"
npm run ci
status=$?
if [ $status -ne 0 ]; then
  echo "pre-push: RED — push BLOCKED. Fix the gate; deploy and release use this same door."
  exit $status
fi
echo "pre-push: ✓ green — deploy and release may follow."
exit 0
